{
  "permissions": {
    "allow": [
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(npm run build*)",
      "Bash(npm run dev*)",
      "Bash(curl -sI *)"
    ],
    "ask": [
      "Bash(git commit*)",
      "Bash(git push*)",
      "Bash(git merge*)",
      "Bash(git rebase*)",
      "Bash(git restore*)",
      "Bash(git stash*)",
      "Bash(npm install*)",
      "Bash(npm i *)",
      "Bash(rm *)",
      "PowerShell(Remove-Item*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/check-build.sh\"",
            "timeout": 120,
            "statusMessage": "Checking that the site still builds…"
          }
        ]
      }
    ]
  }
}
