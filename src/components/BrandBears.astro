---
// BRAND – THE BEARS TODAY. First version: the wording is a draft for me to rewrite, except my
// last line. Everything Cave Wear does here is planned, so the text says so. bearbiology.org is
// a normal link, never a partnership. The olive band is the one the style guide keeps for this.
import { Image } from "astro:assets";
import bear from "../assets/brand/brown-bear.webp";
---

<section id="conservation" class="band section" aria-labelledby="bears-title">
  <div class="container">
    <div class="brand-bears">
      <!-- The trail comes straight down from On Record. Only decoration, so screen readers skip it. -->
      <div class="brand-bears-trail" aria-hidden="true"></div>

      <!-- The bear looks to the right, so it stands left and looks at the text -->
      <Image
        class="brand-bears-photo"
        src={bear}
        alt="A large brown bear walking through a bare forest, seen from the side."
        widths={[480, 800, 1334]}
        sizes="(width >= 64rem) 33vw, (width >= 48rem) 50vw, 100vw"
        loading="lazy"
      />

      <div class="brand-bears-text">
        <h2 id="bears-title">Still Here</h2>
        <p class="lead-small">The cave bear is extinct. Our bears aren't.</p>
        <p>
          Eight bear species live today. The IUCN Red List, the world's main list of threatened
          species, counts six of them as vulnerable to extinction.
          <!-- Only where the brown bear text isn't shown, which says the same -->
          <span class="brand-bears-short">Where people take over more of their land, bears lose their habitat and their numbers fall.</span>
        </p>

        <!-- Desktop only: fills the empty space beside the photo, phones keep the shorter text -->
        <div class="brand-bears-extra">
          <h3>The European brown bear</h3>
          <p>
            We mostly talk about the polar bear, and its situation really is bad. But here, the
            European brown bear gets a special place. It isn't one of those six, yet we took so much
            of its habitat that it's gone from large parts of Europe. In 2006 a brown bear named Bruno
            walked into Bavaria, the first wild bear in Germany in about 170 years. It was shot within
            weeks.
          </p>
        </div>

        <h3>What I plan to do</h3>
        <p>
          At the end of every year, I plan to donate a percentage of my profit to bear research and
          conservation. How much is still open. Organisations like the International Association for Bear Research and Management
          (<a href="https://www.bearbiology.org/">bearbiology.org</a>) show what that work looks like.
        </p>
        <p>
          On my Supporter pieces, you will be able to choose what your piece supports, and bears are
          one of the choices. Nothing is sold yet, so nothing has been donated yet.
        </p>

        <p class="lead-small brand-bears-end">That's my bear minimum.</p>
      </div>
    </div>
  </div>
</section>

<style>
  /* Written mobile first. The base = phones: one column, photo on top. */
  .brand-bears {
    position: relative;
    display: grid;
    gap: var(--space-12); /* 48px */

    @media (width >= 48rem) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    @media (width >= 64rem) {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .brand-bears-photo {
    display: block;
    inline-size: 100%;
    block-size: auto;
  }

  .brand-bears-text {
    display: flex;
    flex-direction: column;
    gap: var(--space-4); /* 16px */

    @media (width >= 64rem) {
      grid-column: 2 / -1;
    }

    & :is(h2, h3, p) {
      margin-block-end: 0;
    }

    & h3 {
      margin-block-start: var(--space-8); /* 32px + the 16px gap */
    }

    /* On olive the colour alone can't say "link" */
    & a {
      text-decoration: underline;
    }
  }

  @media (width >= 90rem) {
    .brand-bears-short {
      display: none;
    }
  }

  .brand-bears-extra {
    display: none;
    margin-block-start: var(--space-8); /* 32px + the 16px gap */

    /* Only from 1440px: the photo is tall enough there, so this
       fills the space beside it and the section doesn't grow */
    @media (width >= 90rem) {
      display: grid;
      gap: var(--space-4); /* 16px */
    }

    & h3 {
      margin-block-start: 0;
    }
  }

  /* Laptops: the photo isn't at its full height yet, so the headings sit 16px closer to the
     text above them, and the section still doesn't grow. */
  @media (90rem <= width < 97rem) {
    .brand-bears-extra,
    .brand-bears-text > h3 {
      margin-block-start: var(--space-4); /* 16px + the 16px gap */
    }
  }

  /* My last line, on the same bottom edge as the photo */
  .brand-bears-text .brand-bears-end {
    margin-block-start: auto;
    padding-block-start: var(--space-8); /* 32px */

    @media (width >= 90rem) {
      padding-block-start: var(--space-6); /* 24px, so it ends level with the photo */
    }
  }

  /* The trail: straight down between the photo and the text. On phones it isn't there. */
  .brand-bears-trail {
    --trail-at: 50%;

    display: none;

    @media (width >= 48rem) {
      display: block;
      position: absolute;
      inset-block: calc(-1 * var(--section-space));
      inset-inline-start: var(--trail-at);
      inline-size: 1px;
      color: var(--color-line);
      background-image: var(--trail-down);
      background-repeat: no-repeat;
    }

    @media (width >= 64rem) {
      --trail-at: calc((100% - 2 * var(--space-12)) / 3 + var(--space-12) / 2);
    }
  }

  @media (width >= 48rem) and (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      /* Written as single lines on purpose, see BrandTrail.astro.
         The range differs from the other sections: the page stops here, so the green section's
         bottom never reaches the middle of the screen. The line starts where On Record's line
         ends (the green's top at 75% of the screen) and finishes when the green's bottom is at
         85%. That is about as far as you scroll, so it draws smoothly and always arrives. */
      .brand-bears-trail {
        animation-name: brand-bears-trail-draw;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: view();
        animation-range: cover 25vh cover calc(100% - 85vh);
      }
    }
  }

  @keyframes brand-bears-trail-draw {
    from {
      background-size: 1px 0;
    }
    to {
      background-size: 1px 100%;
    }
  }
</style>
