---
// BRAND – WHY WE EXIST (2 Nov). Desktop: my text word for word in the left half, one photo in the
// right half, with the trail around it (4 Nov). Phones and tablets: the photo is the background.
// The photo comes from the product folder, with its alt text from there: the embroidered
// bear of the Field Hoodie, for now.
import { Image } from "astro:assets";
import BrandPrinciples from "./BrandPrinciples.astro";
import BrandTrail from "./BrandTrail.astro";
import Coordinates from "./Coordinates.astro";
import { getProducts } from "../data/products";

const products = await getProducts();
const hoodie = products.find((item) => item.id === "field-hoodie");
const photo = hoodie?.shotSets[0].shots.find((shot) => shot.number === 4);
---

<section id="why-we-exist" class="container section brand-why-section" aria-labelledby="why-title">
  <div class="brand-why">
    <!-- The trail comes in from the middle of the page and wraps around the photo's right
         side. Only decoration, so screen readers skip it. -->
    <div class="brand-why-trail" aria-hidden="true"></div>

    <h2 id="why-title" data-appear>Why Cave Wear Exists</h2>

    <div class="brand-why-text" data-appear>
      <p class="lead-small brand-why-question">
        Cave Wear started with a simple question: why should outdoor clothing look like outdoor
        clothing?
      </p>
      <p>
        It began on my first trip to Sweden, around midsummer 2022. I saw many different clothes,
        and they were mostly very practical. But outdoor clothing has a problem that goes through
        most brands that concentrate on functionality: the fit is a very basic fit that doesn't
        look very aesthetically pleasing on many people.
      </p>
      <p>
        Cave Wear's team currently consists of one person, and that's me. How I got here is a
        longer story.
      </p>
      <!-- Phones: the middle of my story folds away behind this button (description-toggle.js).
           Tablet and desktop: no button, and these two wrappers don't count for the layout. -->
      <button type="button" class="description-toggle brand-why-toggle" aria-expanded="false" aria-controls="why-more">
        <span class="brand-why-toggle-closed">Read the whole story</span>
        <span class="brand-why-toggle-open">The whole story</span>
      </button>
      <div class="brand-why-more" id="why-more">
        <div class="brand-why-more-inner">
      <p>
        I've always felt most comfortable in functional, tactical clothing, but it doesn't always
        suit every occasion. And clothes that do look sharp have their own problems: either I spend
        a long time styling them until they look right, or I have to be careful in them all day. I
        love it when I can just live my life, put everything in the washing machine without
        thinking about it, and walk through thorns without worrying about ripping anything. So I
        wanted something different: clothing that could handle the outdoors without looking out of
        place anywhere else.
      </p>
      <p>
        My background in media technology, graphic design, and merchandise production shaped the
        way I approached the idea. Working with different materials and printing techniques taught
        me to pay attention to the details behind a garment, not just how it looks.
      </p>
      <p>
        I wanted to bring that experience together with my love for nature, exploring materials
        that balance durability, comfort, design, and environmental responsibility. During my
        research, I came across wood-fibre fabrics, opening up new possibilities for what everyday
        outdoor-inspired clothing could be.
      </p>
        </div>
      </div>
      <!-- Brente Holme, where the idea began. The text doesn't name it: the numbers do, for
           anyone who looks them up. The div keeps the empty status line out of the grid gap. -->
      <div class="brand-why-coordinates">
        <BrandTrail untilDesktop short />
        <div class="brand-why-coordinates-spot">
          <Coordinates place="brente-holme" />
        </div>
        <BrandTrail untilDesktop short />
      </div>
    </div>

    {
      photo?.image && (
        <div class="brand-why-media">
          <Image
            src={photo.image}
            alt={photo.alt}
            class="brand-why-photo"
            widths={[640, 960, 1280, 1600]}
            sizes="(width >= 64rem) 50vw, 80vh"
          />
        </div>
      )
    }
  </div>

  <BrandPrinciples />
</section>

<script src="../scripts/description-toggle.js"></script>
<script src="../scripts/brand-why-fade.js"></script>

<style>
  /* Written mobile first. The base = phones and tablets: one column, the photo as the background.
     Where these notes say "phones", tablets (768–1023px) are meant too (decided 5 Nov): two halves
     were too narrow there, the heading ran through the trail. Tablets only add this: the text keeps
     a reading width on the middle. Padding and not a margin, so the photo still reaches the edges. */
  .brand-why {
    @media (48rem <= width < 64rem) {
      padding-inline: calc(50% - 18rem); /* 576px wide */
    }
  }

  .brand-why-section {
    /* Phones: its own stack of layers, so the photo lies behind the text but above the page */
    isolation: isolate;

    @media (width >= 64rem) {
      isolation: auto;
    }

    --brand-why-gap: var(--space-12); /* 48px */
    --brand-why-shift: var(--space-6); /* how far the photo stays from the section's right edge: 24px on tablets */

    /* Wide screens: the trail's right side comes further in */
    @media (width >= 80rem) {
      --brand-why-shift: var(--space-24); /* 96px */
    }
  }

  .brand-why {
    position: relative;
    display: grid;
    gap: var(--space-4); /* 16px */
    text-align: center; /* phones: one narrow column, so everything sits on the middle like the part above */

    /* Two equal halves: the heading across both, then the text and the photo. The trail runs
       down the page's middle, so half the gap keeps both 24px from it. */
    @media (width >= 64rem) {
      text-align: start;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-4) var(--brand-why-gap); /* 16px between rows, 48px between columns */
      align-items: start;
    }

    /* The photo's box stretches to the height of the text (see .brand-why-photo) */
    @media (width >= 87.5rem) {
      align-items: stretch;
    }
  }

  .brand-why h2 {
    margin-block: 55svh 0; /* phones: the first screen belongs to the photo, the heading stands low on it */

    @media (width >= 64rem) {
      grid-column: 1 / -1;
      margin-block-start: 0;
    }
  }

  /* Phones: "contents" = this box doesn't count, its parts join the grid above, so the photo can
     sit between my question and my story (order). From tablet up the text is one block again. */
  .brand-why-text {
    display: contents;

    & > * {
      order: 3;
    }

    @media (width >= 64rem) {
      display: grid;
      gap: var(--space-4); /* 16px */

      & > * {
        order: 0;
      }
    }
  }

  /* The fold, same chevron as on the product page. Without JavaScript: no button, all the text. */
  .brand-why-toggle {
    display: none;
    justify-self: start;
    align-items: center;
    gap: var(--space-3); /* 12px */
    min-block-size: var(--control-height);
    /* The button is taller than its words (for fingers). Takes that back below them, so the space
       under the words is the same as under a paragraph. */
    margin-block-end: calc((var(--leading-body) - var(--control-height)) / 2);
    padding: 0;
    transition: margin-block-end var(--motion-duration) var(--motion-ease);
    border: 0;
    background: none;
    color: var(--color-accent);
    font: inherit;
    letter-spacing: inherit;
    cursor: pointer;

    &::after {
      content: "";
      inline-size: 0.375rem;
      block-size: 0.375rem;
      border-block-end: 1.5px solid currentColor;
      border-inline-end: 1.5px solid currentColor;
      translate: 0 -2px;
      rotate: 45deg;
    }

    &[aria-expanded="true"]::after {
      translate: 0 2px;
      rotate: -135deg;
    }

    /* Closed, the folded text has no height, but still its 16px gap: this takes the gap back */
    &[aria-expanded="false"] {
      margin-block-end: calc((var(--leading-body) - var(--control-height)) / 2 - var(--space-4));
    }

    &:focus-visible {
      outline: var(--focus-ring);
      outline-offset: var(--focus-offset);
    }
  }

  /* Two labels, and aria-expanded (flipped by description-toggle.js) decides which one shows */
  .brand-why-toggle[aria-expanded="false"] .brand-why-toggle-open,
  .brand-why-toggle[aria-expanded="true"] .brand-why-toggle-closed {
    display: none;
  }

  :global(html[data-js]) .brand-why-toggle {
    display: inline-flex;

    @media (width >= 64rem) {
      display: none;
    }
  }

  /* 0fr to 1fr = it grows from nothing to exactly the height of the text */
  .brand-why-more {
    display: grid;
    grid-template-rows: 1fr;
    transition:
      grid-template-rows var(--motion-duration) var(--motion-ease),
      visibility var(--motion-duration);

    @media (width >= 64rem) {
      display: contents;
    }
  }

  .brand-why-more-inner {
    display: grid;
    gap: var(--space-4); /* 16px */
    min-block-size: 0;
    overflow: hidden;

    @media (width >= 64rem) {
      display: contents;

      /* It's the last in this box, but my story goes on after it: keep the normal space */
      & p:last-child {
        margin-block-end: var(--space-4); /* 16px */
      }
    }
  }

  :global(html[data-js]) .brand-why-toggle[aria-expanded="false"] + .brand-why-more {
    grid-template-rows: 0fr;
    visibility: hidden;

    /* From tablet up the text is always there, also for screen readers */
    @media (width >= 64rem) {
      visibility: visible;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .brand-why-more,
    .brand-why-toggle {
      transition: none;
    }
  }

  /* Phones: only the 16px gap between the parts. From tablet up: the page's normal space on top. */
  .brand-why-text p {
    margin-block-end: 0;
    color: var(--color-text-secondary);
    text-align: start; /* long text reads best from a straight left edge */
    text-wrap: pretty; /* no single word alone on the last line */

    @media (width >= 64rem) {
      margin-block-end: var(--space-4); /* 16px */
      text-wrap: wrap;
    }
  }

  /* Phones: the numbers stand in the exact middle between my text and my principles, with the
     line above and below them: 24px, 40px of line, 12px, the numbers, 12px, 40px of line, 24px. */
  .brand-why-coordinates {
    padding-block-start: var(--space-2); /* 8px + the 16px gap above = 24px */

    @media (width >= 64rem) {
      padding-block-start: 0;
    }

    /* Phones: over the photo, and Muted Stone only works on the dark page, so one step lighter */
    @media (width < 64rem) {
      --color-text-quiet: var(--color-text-secondary);
    }
  }

  .brand-why-coordinates-spot {
    display: grid;
    justify-items: center;
    padding-block: var(--space-3); /* 12px */

    @media (width >= 64rem) {
      justify-items: start;
      padding-block: 0;
    }
  }

  .brand-why-text .brand-why-question {
    order: 1;
    margin-block-end: var(--space-4); /* 16px + the 16px gap */
    margin-inline: auto; /* big phones: the sentence stops at its reading width, so its box has to be on the middle too */
    color: var(--color-text);
    text-align: center;

    @media (width >= 64rem) {
      order: 0;
      margin-inline: 0;
      text-align: start;
    }
  }

  /* Phones (my decision, 4 Nov): the photo is the background of the whole section. This box runs
     from screen edge to screen edge, behind everything, and one screen further than my text, so
     the photo can stay until it has faded out over my principles (brand-why-fade.js). */
  .brand-why-media {
    position: absolute;
    z-index: -1;
    inset-block: 0 -100svh;
    inset-inline: calc(-1 * var(--gutter));
    pointer-events: none;

    /* From tablet up the trail wraps around the photo, 24px away on the top, left and right
       (my decision, 4 Nov). The margin keeps it inside the trail's right side. */
    @media (width >= 64rem) {
      position: relative;
      z-index: auto;
      inset: auto;
      margin-inline-end: var(--brand-why-shift);
      pointer-events: auto;
    }
  }

  /* Phones: one whole screen, staying in place (sticky) inside its box while the text passes over
     it. Dimmed for the text, and its top and bottom melt into the page. Sticky works on iPhones,
     where a fixed background picture doesn't.
     Tablets and small desktops: 4:5, so the bear is never cut off. From 1400px: exactly as high as
     the text, from my question to the last line (decided 2 Nov). Below that the text is so tall and
     the photo so narrow that stretching would cut the bear. The photo is taken out of the flow
     (absolute), so only the text decides the height, and it follows when the text changes. */
  .brand-why-photo {
    position: sticky;
    inset-block-start: 0;
    inline-size: 100%;
    block-size: 100svh;
    object-fit: cover;
    filter: brightness(0.6); /* measured: dark enough for Wild Honey and my grey text, also on the stitching */
    -webkit-mask-image: linear-gradient(to bottom, transparent, black 15%, black 85%, transparent);
    mask-image: linear-gradient(to bottom, transparent, black 15%, black 85%, transparent);

    @media (width >= 64rem) {
      position: static;
      block-size: auto;
      aspect-ratio: 4 / 5;
      filter: none;
      -webkit-mask-image: none;
      mask-image: none;
    }

    @media (width >= 87.5rem) {
      position: absolute;
      inset: 0;
      block-size: 100%;
      aspect-ratio: auto;
    }
  }

  /* The trail's turn. One box with three lines as its backgrounds: down from where
     BrandTrail ends, across, and down the photo's right side. The line keeps 24px from the
     photo on both sides (decided 2 Nov). The box starts 24px above the heading, the photo
     starts under the heading, so --trail-turn (heading + its gap) is where the line turns.
     On phones there's nowhere to turn, so it isn't there. */
  .brand-why-trail {
    --trail-turn: calc(var(--leading-h2) + var(--space-4));

    display: none;

    @media (width >= 64rem) {
      display: block;
      position: absolute;
      inset-block: calc(-1 * var(--space-6)) 0;
      inset-inline-start: 50%;
      inset-inline-end: calc(var(--brand-why-shift) - var(--space-6));
      color: var(--color-input-border); /* Flint */
      background-image: var(--trail-down), var(--trail-across), var(--trail-down);
      background-position:
        top left,
        left 0 top var(--trail-turn),
        right 0 top var(--trail-turn);
      background-size:
        1px var(--trail-turn),
        100% 1px,
        1px calc(100% - var(--trail-turn));
      background-repeat: no-repeat;
    }
  }

  /* It draws itself while you scroll, right where BrandTrail stops: a little further down,
     then it slides across, then down the side. */
  @media (width >= 64rem) and (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      /* Written as single lines on purpose: the build would join a full "animation:"
         line and view() into one, which some browsers can't read */
      .brand-why-trail {
        animation-name: brand-why-trail-draw;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: view();
        animation-range: cover 50vh cover calc(100% - 50vh);
      }
    }
  }

  /* Each line grows from nothing, because a size of 0 draws nothing. The dashes keep their
     length while it grows (they're set in px), so the line slides out, it doesn't stretch. */
  @keyframes brand-why-trail-draw {
    from {
      background-size:
        1px 0,
        0 1px,
        1px 0;
    }
    10% {
      background-size:
        1px var(--trail-turn),
        0 1px,
        1px 0;
    }
    40% {
      background-size:
        1px var(--trail-turn),
        100% 1px,
        1px 0;
    }
    to {
      background-size:
        1px var(--trail-turn),
        100% 1px,
        1px calc(100% - var(--trail-turn));
    }
  }
</style>
