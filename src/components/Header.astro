---
import Logo from "../assets/logo-horizontal.svg";
import BagIcon from "../assets/icons/backpack.svg";
import MenuIcon from "../assets/icons/menu.svg";
import CloseIcon from "../assets/icons/close.svg";
import SocialLinks from "./SocialLinks.astro";

// The main links. To add or rename a page, change only this list.
const navLinks = [
  { href: "/products", label: "Products" },
  { href: "/brand", label: "Brand" },
  { href: "/contact", label: "Contact" },
];

// The address of the page being built, without a slash at the end ("/products/" → "/products")
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";

// "page" = this is the current page. "true" = we are inside this section
// (e.g. /products/beanie is inside Products). Otherwise no attribute.
function getCurrent(href: string) {
  if (currentPath === href) return "page";
  if (currentPath.startsWith(href + "/")) return "true";
  return undefined;
}

// Pages that start with a full-width photo: the header starts transparent
// (the photo shows through) and turns solid on scroll. Add new pages here.
const photoHeaderPages = ["/", "/products"];
const isTransparent = photoHeaderPages.includes(currentPath);

// Product pages (/products/core-tee …): the header never hides, so Pack stays in reach
const isPinned = currentPath.startsWith("/products/");
---

<!-- Fallback for browsers without scroll-driven animations: invisible marker
     32px below the top. When it scrolls out of view, the header turns solid
     (see header-scroll.js). -->
<div class="scroll-sentinel" aria-hidden="true"></div>

<header class="site-header" data-transparent={isTransparent ? "" : undefined} data-pinned={isPinned ? "" : undefined}>
  <div class="container header-inner">
    <a href="/" class="logo" aria-label="Cave Wear – Home">
      <Logo aria-hidden="true" />
    </a>

    <nav class="nav" aria-label="Main navigation">
      <!-- Mobile only. Shown by CSS when JavaScript works. -->
      <button
        type="button"
        class="menu-button"
        aria-label="Menu"
        aria-expanded="false"
        aria-controls="main-menu"
      >
        <MenuIcon class="menu-icon menu-icon-open" />
        <CloseIcon class="menu-icon menu-icon-close" />
      </button>

      <!-- On desktop the panel is invisible as a box (display: contents) –
           only the link list shows. On mobile it is the full-screen menu. -->
      <div id="main-menu" class="menu-panel">
        <ul class="nav-list" role="list">
          {
            navLinks.map((link, index) => (
              <li style={`--i: ${index}`}>
                <a href={link.href} class="nav-link" aria-current={getCurrent(link.href)}>
                  <span class="link-label" data-label={link.label}>
                    {link.label}
                  </span>
                </a>
              </li>
            ))
          }
        </ul>

        <!-- Bottom of the mobile menu, in reach of the thumb -->
        <div class="menu-footer">
          <p class="menu-tagline">Built for the wild. Made for anywhere.</p>
          <SocialLinks />
        </div>
      </div>

      <a href="/bag" class="nav-link bag-link" aria-current={getCurrent("/bag")}>
        <BagIcon class="bag-icon" />
        <span class="link-label" data-label="Pack">Pack</span>
      </a>
    </nav>
  </div>
</header>

<script src="../scripts/mobile-menu.js"></script>
<script src="../scripts/header-scroll.js"></script>
<script src="../scripts/header-hide.js"></script>

<style>
  .scroll-sentinel {
    position: absolute;
    inset-block-start: var(--space-8); /* 32px */
    inline-size: 1px;
    block-size: 1px;
    pointer-events: none;
  }

  /* Sticky bar, solid Dark Obsidian – same as the page, the line is the edge */
  .site-header {
    position: sticky;
    inset-block-start: 0;
    z-index: 50;
    background-color: var(--color-bg);
    border-block-end: 1px solid var(--color-line);
    transition:
      background-color 0.3s ease,
      border-color 0.3s ease,
      translate 0.3s ease;
  }

  /* --- Photo pages (Home, Products): background fade ----------------------- */

  /* From 5% Dark Obsidian (no line) to solid Dark Obsidian (with line) */
  @keyframes header-fill {
    from {
      background-color: color-mix(in srgb, var(--color-bg) 5%, transparent);
      border-block-end-color: transparent;
    }
    to {
      background-color: var(--color-bg);
      border-block-end-color: var(--color-line);
    }
  }

  /* The Bag button fades with the header: fill and outline appear together
     with the background (5% Obsidian, no outline → solid Obsidian, Flint) */
  @keyframes bag-fill {
    from {
      background-color: color-mix(in srgb, var(--color-surface) 5%, transparent);
      border-color: transparent;
    }
    to {
      background-color: var(--color-surface);
      border-color: var(--color-input-border);
    }
  }

  /* Modern browsers: the page scroll drives the animation.
     0px scrolled = 5%, --header-fade-distance (200px) scrolled = solid. */
  @supports (animation-timeline: scroll()) {
    /* Start look without the animation: if the page is too short to scroll
       (e.g. on a tall monitor), the scroll animation does not run at all –
       the header must then stay see-through, not fall back to solid. */
    .site-header[data-transparent]:not(:has(.menu-button[aria-expanded="true"])) {
      background-color: color-mix(in srgb, var(--color-bg) 5%, transparent);
      border-block-end-color: transparent;
    }

    .site-header[data-transparent]:not(:has(.menu-button[aria-expanded="true"])) .bag-link:not(:hover) {
      background-color: color-mix(in srgb, var(--color-surface) 5%, transparent);
      border-color: transparent;
    }

    /* Written as separate properties on purpose: the CSS minifier would merge
       a shorthand + animation-timeline into one line that Chrome rejects. */
    .site-header[data-transparent] {
      animation-name: header-fill;
      animation-timing-function: linear;
      animation-fill-mode: both;
      animation-timeline: scroll(root);
      animation-range: 0 var(--header-fade-distance);
    }

    /* Mobile menu open: always solid */
    .site-header[data-transparent]:has(.menu-button[aria-expanded="true"]) {
      animation: none;
    }

    /* Same scroll timeline as the header */
    .site-header[data-transparent] .bag-link {
      animation-name: bag-fill;
      animation-timing-function: linear;
      animation-fill-mode: both;
      animation-timeline: scroll(root);
      animation-range: 0 var(--header-fade-distance);
    }

    /* An animation beats normal styles – so it is switched off on hover
       (Egret box shows) and while the mobile menu is open (solid) */
    .site-header[data-transparent] .bag-link:hover,
    .site-header[data-transparent]:has(.menu-button[aria-expanded="true"]) .bag-link {
      animation-name: none;
    }
  }

  /* Older browsers (fallback): almost invisible at the top, solid after 32px.
     Only with JavaScript (otherwise it would stay transparent forever),
     and never while the mobile menu is open. */
  @supports not (animation-timeline: scroll()) {
    :global(html[data-js]) .site-header[data-transparent]:not([data-scrolled]):not(:has(.menu-button[aria-expanded="true"])) {
      background-color: color-mix(in srgb, var(--color-bg) 5%, transparent);
      border-block-end-color: transparent;
    }

    :global(html[data-js]) .site-header[data-transparent]:not([data-scrolled]):not(:has(.menu-button[aria-expanded="true"])) .bag-link:not(:hover) {
      background-color: color-mix(in srgb, var(--color-surface) 5%, transparent);
      border-color: transparent;
    }
  }

  /* --- Hide on scroll down / show on scroll up (header-hide.js) ---------- */

  /* Slides up out of view – but never while keyboard focus is inside the
     header (:focus-within) or while the mobile menu is open */
  .site-header[data-hidden]:not(:focus-within):not(:has(.menu-button[aria-expanded="true"])) {
    translate: 0 -100%;
  }

  .header-inner {
    display: flex;
    flex-wrap: wrap; /* without JavaScript, the nav wraps below the logo on small screens */
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3) var(--space-8);
    min-block-size: var(--header-height);
    padding-block: var(--space-2); /* 8px + 48px nav link + 8px = 64px */
  }

  /* Logo: colour comes from CSS through currentColor */
  .logo {
    display: block;
    color: var(--color-text);
    transition: color 0.2s ease;

    & svg {
      display: block;
      block-size: var(--space-8); /* 32px – 16px space above and below in the 64px header */
      inline-size: auto;
    }

    &:hover {
      color: var(--color-accent-hover);
    }
  }

  .nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-8);
  }

  .nav-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-8);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (width < 48rem) {
    .nav,
    .nav-list {
      column-gap: var(--space-6);
    }
  }

  /* Nav links and Pack – normal case, Regular weight, no extra letter-spacing:
     quiet like Linear and Vercel (decided 26 Oct, type version C; was uppercase 500).
     12px + 24px line + 12px = 48px high */
  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding-block: var(--space-3);
    color: var(--color-text-secondary);
    font-size: 1rem; /* 16px */
    font-weight: 400;
    line-height: var(--space-6); /* 24px */
    letter-spacing: var(--tracking-nav);
    transition: color 0.2s ease;

    /* Hover only where a mouse can hover – on touch screens the colour would stick after a tap */
    @media (hover: hover) {
      &:hover {
        color: var(--color-accent);
      }
    }

    /* Active: current page ("page") or a page inside this section ("true") */
    &[aria-current] {
      color: var(--color-text);
      font-weight: 700;
    }
  }

  /* Invisible bold copy of the label: the link is always as wide as its
     bold version, so nothing moves when a link becomes active */
  .link-label {
    display: inline-flex;
    flex-direction: column;
    align-items: center;

    &::after {
      content: attr(data-label);
      content: attr(data-label) / "";
      block-size: 0;
      overflow: hidden;
      visibility: hidden;
      font-weight: 700;
    }
  }

  /* Bag button – the one action in the nav, so it gets a box.
     40px high, 24px icon centred inside, 12px at the sides. */
  .bag-link {
    block-size: var(--control-height); /* 40px – 12px space above and below in the 64px header */
    gap: 0.375rem; /* 6px */
    padding-block: 0;
    padding-inline: var(--space-3); /* 12px */
    border: 0.5px solid var(--color-input-border); /* Flint – hairline, as in the design (0.375pt) */
    border-radius: var(--radius-button); /* 12px – same as every button */
    background-color: var(--color-surface); /* Obsidian */
    transition:
      color 0.2s ease,
      background-color 0.2s ease,
      border-color 0.2s ease,
      box-shadow 0.2s ease,
      backdrop-filter 0.2s ease;

    /* Hover: smoked glass like the hero bear – blur behind, 45% dark tint,
       faint light edge, Egret text. The shadow is kept tiny: it must stay
       inside the header (12px below the button) and not reach the hero. */
    @media (hover: hover) {
      &:hover {
        border-color: var(--glass-edge);
        background-color: var(--glass-tint);
        color: var(--color-text);
        box-shadow: var(--glass-shadow);
        -webkit-backdrop-filter: var(--glass-blur); /* older Safari */
        backdrop-filter: var(--glass-blur);
      }
    }
  }

  /* 24px – about 1.5 × the 16px text, so icon and word look balanced */
  .bag-icon {
    inline-size: var(--space-6);
    block-size: var(--space-6);
  }

  /* Menu button – hidden on desktop and when JavaScript is off */
  .menu-button {
    display: none;
    place-items: center;
    inline-size: var(--space-12); /* 48px */
    block-size: var(--space-12);
    padding: 0;
    border: 0;
    background: none;
    color: var(--color-text);
    cursor: pointer;
    transition: color 0.2s ease;

    /* Without this, the close icon stayed Wild Honey after a tap on phones */
    @media (hover: hover) {
      &:hover {
        color: var(--color-accent);
      }
    }
  }

  /* Desktop: the panel is no box of its own – the link list sits in the nav as before.
     The menu footer only exists in the mobile menu. */
  .menu-panel {
    display: contents;
  }

  .menu-footer {
    display: none;
  }

  /* Both icons sit on top of each other; one is visible at a time */
  .menu-icon {
    grid-area: 1 / 1;
    inline-size: var(--space-6); /* 24px */
    block-size: var(--space-6);
    transition:
      opacity 0.2s ease,
      transform 0.2s ease;
  }

  .menu-icon-close {
    opacity: 0;
    transform: rotate(-90deg);
  }

  .menu-button[aria-expanded="true"] {
    & .menu-icon-open {
      opacity: 0;
      transform: rotate(90deg);
    }

    & .menu-icon-close {
      opacity: 1;
      transform: rotate(0);
    }
  }

  /* Mobile menu – only below 768px and only when JavaScript works */
  @media (width < 48rem) {
    :global(html[data-js]) {
      & .header-inner {
        flex-wrap: nowrap;
      }

      & .nav {
        flex-wrap: nowrap;
        column-gap: var(--space-4);
      }

      & .menu-button {
        display: grid;
      }

      /* Bag sits left of the menu button */
      & .bag-link {
        order: -1;
      }

      /* The panel becomes a full-screen menu below the header:
         links at the top, tagline + socials at the bottom (thumb zone) */
      & .menu-panel {
        position: fixed;
        inset-block-start: var(--header-height);
        inset-inline: 0;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        gap: var(--space-12);
        block-size: calc(100dvh - var(--header-height));
        padding: var(--space-8) var(--gutter) var(--space-12);
        overflow-y: auto;
        /* Smoked glass, but much darker than the normal glass (45%): 92% Dark Obsidian,
           the page behind only shows as a hint (chosen 28 Oct from 75 / 85 / 92%) */
        background-color: color-mix(in srgb, var(--color-bg) 92%, transparent);
        -webkit-backdrop-filter: var(--glass-blur); /* older Safari */
        backdrop-filter: var(--glass-blur);

        /* Closed: invisible and not reachable with Tab */
        visibility: hidden;
        opacity: 0;
        transition:
          opacity 0.2s ease,
          visibility 0s linear 0.2s;
      }

      & .nav-list {
        flex-direction: column;
        flex-wrap: nowrap;
        gap: 0;
      }

      /* Each link comes in a little after the one above it (--i = 0, 1, 2 from the list) */
      & .nav-list li {
        border-block-end: 1px solid var(--color-line);
        opacity: 0;
        translate: 0 var(--space-2);
        transition:
          opacity 0.3s ease,
          translate 0.3s ease;
      }

      /* Light and a little tight, like the H3 (Geist 450, −0.03em).
         Active = bold Egret, the same as the desktop nav.
         12px + 28px line + 12px = 52px high – comfortable for the thumb (Google: 48) */
      & .nav-list .nav-link {
        display: flex;
        padding-block: var(--space-3);
        font-size: var(--text-h3); /* 24px – chosen 27 Oct from 20px vs 24px */
        font-weight: 450;
        line-height: var(--leading-h3); /* 28px */
        letter-spacing: var(--tracking-h3);

        &[aria-current] {
          font-weight: 700;
        }
      }

      & .nav-list .link-label {
        align-items: flex-start;
      }

      & .menu-footer {
        display: grid;
        gap: var(--space-2);
        opacity: 0;
        transition: opacity 0.3s ease;
      }

      & .menu-tagline {
        margin: 0;
        color: var(--color-text-quiet);
        font-size: var(--text-small);
        line-height: var(--leading-small);
      }
    }

    /* Open: panel visible, page behind it does not scroll */
    :global(html[data-js]:has(.menu-button[aria-expanded="true"])) {
      overflow: hidden;

      & .menu-panel {
        visibility: visible;
        opacity: 1;
        transition:
          opacity 0.2s ease,
          visibility 0s;
      }

      /* Links one after another, 50ms apart; the footer last */
      & .nav-list li {
        opacity: 1;
        translate: 0 0;
        transition-delay: calc(0.05s + var(--i) * 0.05s);
      }

      & .menu-footer {
        opacity: 1;
        transition-delay: 0.25s;
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header,
    .logo,
    .nav-link,
    .menu-button,
    .menu-icon,
    .menu-panel,
    .nav-list li,
    .menu-footer,
    .bag-link {
      transition: none !important;
    }
  }
</style>
