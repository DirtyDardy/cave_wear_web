---
import Logo from "../assets/logo-horizontal.svg";
import BagIcon from "../assets/icons/backpack.svg";
import MenuIcon from "../assets/icons/menu.svg";
import CloseIcon from "../assets/icons/close.svg";

// The main links. To add or rename a page, change only this list.
const navLinks = [
  { href: "/products", label: "Products" },
  { href: "/brand", label: "Brand" },
  { href: "/contact", label: "Contact" },
];

// The address of the page being built, without a slash at the end ("/products/" → "/products")
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";

// "page" = this is the current page. "true" = we are inside this section
// (e.g. /products/beanie is inside Products). Otherwise no attribute.
function getCurrent(href: string) {
  if (currentPath === href) return "page";
  if (currentPath.startsWith(href + "/")) return "true";
  return undefined;
}

// Only Home starts with a transparent header (the hero shows through)
const isHome = currentPath === "/";
---

<!-- Invisible marker 32px below the top of the page. When it scrolls out of
     view, the header gets its solid background (see header-scroll.js). -->
<div class="scroll-sentinel" aria-hidden="true"></div>

<header class="site-header" data-transparent={isHome ? "" : undefined}>
  <div class="container header-inner">
    <a href="/" class="logo" aria-label="Cave Wear – Home">
      <Logo aria-hidden="true" />
    </a>

    <nav class="nav" aria-label="Main navigation">
      <!-- Mobile only. Shown by CSS when JavaScript works. -->
      <button
        type="button"
        class="menu-button"
        aria-label="Menu"
        aria-expanded="false"
        aria-controls="main-menu"
      >
        <MenuIcon class="menu-icon menu-icon-open" />
        <CloseIcon class="menu-icon menu-icon-close" />
      </button>

      <ul id="main-menu" class="nav-list" role="list">
        {
          navLinks.map((link) => (
            <li>
              <a href={link.href} class="nav-link" aria-current={getCurrent(link.href)}>
                <span class="link-label" data-label={link.label}>
                  {link.label}
                </span>
              </a>
            </li>
          ))
        }
      </ul>

      <a href="/bag" class="nav-link bag-link" aria-current={getCurrent("/bag")}>
        <BagIcon class="bag-icon" />
        <span class="link-label" data-label="Bag">Bag</span>
      </a>
    </nav>
  </div>
</header>

<script src="../scripts/mobile-menu.js"></script>
<script src="../scripts/header-scroll.js"></script>

<style>
  .scroll-sentinel {
    position: absolute;
    inset-block-start: var(--space-8); /* 32px */
    inline-size: 1px;
    block-size: 1px;
    pointer-events: none;
  }

  /* Sticky bar, solid Obsidian */
  .site-header {
    position: sticky;
    inset-block-start: 0;
    z-index: 50;
    background-color: var(--color-surface);
    border-block-end: 1px solid var(--color-line);
    transition:
      background-color 0.3s ease,
      border-color 0.3s ease;
  }

  /* Home, at the very top: background almost invisible, no line.
     Only with JavaScript (otherwise it would stay transparent forever),
     and never while the mobile menu is open. */
  :global(html[data-js]) .site-header[data-transparent]:not([data-scrolled]):not(:has(.menu-button[aria-expanded="true"])) {
    background-color: color-mix(in srgb, var(--color-surface) 5%, transparent);
    border-block-end-color: transparent;
  }

  .header-inner {
    display: flex;
    flex-wrap: wrap; /* without JavaScript, the nav wraps below the logo on small screens */
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3) var(--space-8);
    min-block-size: var(--header-height);
    padding-block: var(--space-3);
  }

  /* Logo: colour comes from CSS through currentColor */
  .logo {
    display: block;
    color: var(--color-text);
    transition: color 0.2s ease;

    & svg {
      display: block;
      block-size: var(--space-8); /* 32px */
      inline-size: auto;
    }

    &:hover {
      color: var(--color-accent-hover);
    }
  }

  .nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-8);
  }

  .nav-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-8);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (width < 48rem) {
    .nav,
    .nav-list {
      column-gap: var(--space-6);
    }
  }

  /* Nav links and Bag – uppercase, wide letter-spacing: the tactical touch.
     12px + 24px line + 12px = 48px high */
  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding-block: var(--space-3);
    color: var(--color-text-secondary);
    font-size: var(--text-small); /* 14px */
    font-weight: 400;
    line-height: var(--space-6); /* 24px */
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    transition: color 0.2s ease;

    &:hover {
      color: var(--color-accent);
    }

    /* Active: current page ("page") or a page inside this section ("true") */
    &[aria-current] {
      color: var(--color-text);
      font-weight: 700;
    }
  }

  /* Invisible bold copy of the label: the link is always as wide as its
     bold version, so nothing moves when a link becomes active */
  .link-label {
    display: inline-flex;
    flex-direction: column;
    align-items: center;

    &::after {
      content: attr(data-label);
      content: attr(data-label) / "";
      block-size: 0;
      overflow: hidden;
      visibility: hidden;
      font-weight: 700;
    }
  }

  /* 24px – same size as the menu icon */
  .bag-icon {
    inline-size: var(--space-6);
    block-size: var(--space-6);
  }

  /* Menu button – hidden on desktop and when JavaScript is off */
  .menu-button {
    display: none;
    place-items: center;
    inline-size: var(--space-12); /* 48px */
    block-size: var(--space-12);
    padding: 0;
    border: 0;
    background: none;
    color: var(--color-text);
    cursor: pointer;
    transition: color 0.2s ease;

    &:hover {
      color: var(--color-accent);
    }
  }

  /* Both icons sit on top of each other; one is visible at a time */
  .menu-icon {
    grid-area: 1 / 1;
    inline-size: var(--space-6); /* 24px */
    block-size: var(--space-6);
    transition:
      opacity 0.2s ease,
      transform 0.2s ease;
  }

  .menu-icon-close {
    opacity: 0;
    transform: rotate(-90deg);
  }

  .menu-button[aria-expanded="true"] {
    & .menu-icon-open {
      opacity: 0;
      transform: rotate(90deg);
    }

    & .menu-icon-close {
      opacity: 1;
      transform: rotate(0);
    }
  }

  /* Mobile menu – only below 768px and only when JavaScript works */
  @media (width < 48rem) {
    :global(html[data-js]) {
      & .header-inner {
        flex-wrap: nowrap;
      }

      & .nav {
        flex-wrap: nowrap;
        column-gap: var(--space-4);
      }

      & .menu-button {
        display: grid;
      }

      /* Bag sits left of the menu button */
      & .bag-link {
        order: -1;
      }

      /* The link list becomes a full-screen panel below the header */
      & .nav-list {
        position: fixed;
        inset-block-start: var(--header-height);
        inset-inline: 0;
        block-size: calc(100dvh - var(--header-height));
        flex-direction: column;
        flex-wrap: nowrap;
        gap: 0;
        padding: var(--space-8) var(--gutter);
        overflow-y: auto;
        background-color: var(--color-surface);

        /* Closed: invisible and not reachable with Tab */
        visibility: hidden;
        opacity: 0;
        transform: translateY(calc(-1 * var(--space-2)));
        transition:
          opacity 0.2s ease,
          transform 0.2s ease,
          visibility 0s linear 0.2s;
      }

      & .nav-list li + li {
        border-block-start: 1px solid var(--color-line);
      }

      /* 16px + 32px line + 16px = 64px high */
      & .nav-list .nav-link {
        display: flex;
        padding-block: var(--space-4);
        font-size: 1.5rem;
        line-height: var(--space-8);
      }

      & .nav-list .link-label {
        align-items: flex-start;
      }
    }

    /* Open: panel visible, page behind it does not scroll */
    :global(html[data-js]:has(.menu-button[aria-expanded="true"])) {
      overflow: hidden;

      & .nav-list {
        visibility: visible;
        opacity: 1;
        transform: none;
        transition:
          opacity 0.2s ease,
          transform 0.2s ease,
          visibility 0s;
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header,
    .logo,
    .nav-link,
    .menu-button,
    .menu-icon,
    .nav-list {
      transition: none !important;
    }
  }
</style>
