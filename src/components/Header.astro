---
import Logo from "../assets/logo-horizontal.svg";
import BagIcon from "../assets/icons/bag.svg";

// The main links. To add or rename a page, change only this list.
const navLinks = [
  { href: "/products", label: "Products" },
  { href: "/brand", label: "Brand" },
  { href: "/contact", label: "Contact" },
];

// The address of the page being built, without a slash at the end ("/products/" → "/products")
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";

// "page" = this is the current page. "true" = we are inside this section
// (e.g. /products/beanie is inside Products). Otherwise no attribute.
function getCurrent(href: string) {
  if (currentPath === href) return "page";
  if (currentPath.startsWith(href + "/")) return "true";
  return undefined;
}
---

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="logo" aria-label="Cave Wear – Home">
      <Logo aria-hidden="true" />
    </a>

    <nav class="nav" aria-label="Main navigation">
      <ul class="nav-list" role="list">
        {
          navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="nav-link"
                data-label={link.label}
                aria-current={getCurrent(link.href)}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>

      <a href="/bag" class="bag-link" aria-current={getCurrent("/bag")}>
        <BagIcon class="bag-icon" />
        <span>Bag</span>
      </a>
    </nav>
  </div>
</header>

<style>
  /* Sticky bar, slightly see-through with a blur behind it */
  .site-header {
    position: sticky;
    inset-block-start: 0;
    z-index: 50;
    background-color: color-mix(in srgb, var(--color-surface) 85%, transparent);
    backdrop-filter: blur(12px);
    border-block-end: 1px solid var(--color-line);
  }

  .header-inner {
    display: flex;
    flex-wrap: wrap; /* until the mobile menu exists, the nav wraps below the logo */
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3) var(--space-8);
    min-block-size: var(--header-height);
    padding-block: var(--space-3);
  }

  /* Logo: colour comes from CSS through currentColor */
  .logo {
    display: block;
    color: var(--color-text);
    transition: color 0.2s ease;

    & svg {
      display: block;
      block-size: 1.75rem; /* 28px = 7 × 4 */
      inline-size: auto;
    }

    &:hover {
      color: var(--color-accent-hover);
    }
  }

  .nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-8);
  }

  .nav-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-8);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (width < 48rem) {
    .nav,
    .nav-list {
      column-gap: var(--space-6);
    }
  }

  /* Shared style: uppercase, wide letter-spacing – the tactical touch */
  .nav-link,
  .bag-link {
    font-size: 0.875rem;
    line-height: var(--space-6); /* 24px */
    letter-spacing: 0.14em;
    text-transform: uppercase;
    transition:
      color 0.2s ease,
      border-color 0.2s ease;
  }

  /* 12px + 24px line + 12px = 48px high */
  .nav-link {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    padding-block: var(--space-3);
    color: var(--color-text-secondary);
    font-weight: 400;

    &:hover {
      color: var(--color-text);
    }

    /* Active: current page ("page") or a page inside this section ("true") */
    &[aria-current] {
      color: var(--color-text);
      font-weight: 700;
    }

    /* Invisible bold copy of the label: the link is always as wide as its
       bold version, so nothing moves when a link becomes active */
    &::after {
      content: attr(data-label);
      content: attr(data-label) / "";
      block-size: 0;
      overflow: hidden;
      visibility: hidden;
      font-weight: 700;
    }
  }

  /* Bag: framed like a small tag, set apart from the page links */
  .bag-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    block-size: var(--space-12); /* 48px, same as the nav links */
    padding-inline: var(--space-4);
    border: 1px solid var(--color-flint);
    border-radius: 2px;
    color: var(--color-text);
    font-weight: 500;

    &:hover,
    &[aria-current] {
      border-color: var(--color-accent);
      color: var(--color-accent);
    }
  }

  .bag-icon {
    inline-size: var(--space-4);
    block-size: var(--space-4);
  }

  @media (prefers-reduced-motion: reduce) {
    .logo,
    .nav-link,
    .bag-link {
      transition: none;
    }
  }
</style>
