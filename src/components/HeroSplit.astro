---
// SPLIT HERO (prototype) – one cave, two sides: the wild and anywhere.
// The diagonal cut is the same cut that runs through the bear logo.
// The bear is smoked glass (decided 22 Oct 2026).
// To change a photo: replace the file in src/assets/hero/ (keep the file name).
import { Image } from "astro:assets";
import wildImage from "../assets/hero/hero-wild.jpg";
import anywhereImage from "../assets/hero/hero-anywhere.jpg";

// Which part of each photo stays visible ("center", "center 70%" = a bit lower)
interface Props {
  wildFocus?: string;
  anywhereFocus?: string;
}

const { wildFocus = "center", anywhereFocus = "center" } = Astro.props;
---

<section class="hero-split" style={`--wild-focus: ${wildFocus}; --anywhere-focus: ${anywhereFocus};`}>
  <h1 class="visually-hidden">Built for the wild. Made for anywhere.</h1>

  <!-- The two photos. Each one is cut along the diagonal (clip-path). -->
  <div class="side side-wild">
    <Image src={wildImage} alt="" class="side-image" widths={[640, 1024, 1600, 2400]} sizes="60vw" loading="eager" fetchpriority="high" />
  </div>
  <div class="side side-anywhere">
    <Image src={anywhereImage} alt="" class="side-image" widths={[640, 1024, 1600, 2400]} sizes="60vw" loading="eager" fetchpriority="high" />
  </div>

  <!-- Glass layer: a blurred copy of both photos, lined up exactly with the
       real ones and cut to the bear's shape with a mask (the logo file).
       Same image files = no extra download. -->
  <div class="bear-glass" aria-hidden="true">
    <div class="glass-scene">
      <div class="side side-wild">
        <Image src={wildImage} alt="" class="side-image" widths={[640, 1024, 1600, 2400]} sizes="60vw" loading="lazy" />
      </div>
      <div class="side side-anywhere">
        <Image src={anywhereImage} alt="" class="side-image" widths={[640, 1024, 1600, 2400]} sizes="60vw" loading="lazy" />
      </div>
    </div>
  </div>

  <!-- The logo bear, in its two halves (paths from public/logo/bear-light.svg) -->
  <svg class="bear" viewBox="0 0 856.42 477.35" aria-hidden="true">
    <defs>
      <!-- Glass edge: bright top-left, dimmer middle, bright again bottom-right -->
      <linearGradient id="bear-edge" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#f3ebe0" stop-opacity="0.95" />
        <stop offset="0.5" stop-color="#f3ebe0" stop-opacity="0.25" />
        <stop offset="1" stop-color="#f3ebe0" stop-opacity="0.7" />
      </linearGradient>
    </defs>
    <g class="bear-half bear-wild">
      <path d="M476.1 425.6c-30.8,21.2 -41.8,31.7 -57.8,51.7l-100.8 0c9.5,-18.1 12.8,-14.4 34.3,-24.6 8.8,-4.1 16.5,-10.6 23,-21.5 -44.4,-40.6 -92.8,-90.1 -117.5,-154.1 -4.6,-1.3 -13.2,-3.1 -22,-2.9 -22.4,0.2 -57.7,7.5 -78,50.5 -15.6,-11 -51.6,-15.6 -70.3,-13.1 -19.3,2.5 -31.5,7.9 -38.9,-3.4 -8.3,3.2 -8.3,4.7 -14.7,1 -10.6,-6.1 -34.6,-41 -33.4,-46.2 0.7,-3.3 17.1,-14.1 21,-17.4 25.5,-21.4 18.1,-16.5 19.5,-32.1 1.3,-14.9 13.9,-22.9 19.3,-30.7 9.1,-13.3 28.2,-33.9 34,-38.3 2.5,-3.7 0.3,-16.1 7.3,-23.9 10.8,-12.3 12.7,-6.2 20.7,0.5 6,-5.8 11,-11.7 16.1,-17.9 49.2,-12.2 74.4,-46.7 84,-64.2l8.9 5.9c62.6,-33.4 66.7,-19.6 131.2,-43.1l114.1 423.9z" />
      <path d="M285.2 383.9c-15.4,28.6 -45.9,50.4 -88.7,42.7 -5.5,18.9 -22.1,41.4 -46.1,50.7 -6.6,-28.6 -7.9,-74.9 9.7,-118.9 23.6,-18.1 36.3,-25.5 53.5,-48.8 5.8,-2.2 13.7,-4.2 21.6,-4 10.8,22.8 23.8,46.2 50,78.2z" />
    </g>
    <g class="bear-half bear-anywhere">
      <path d="M524.9 453.3c24.8,-11.7 43.2,-38.8 44.8,-69.9 30.4,5 50.6,7.7 82.1,4.8 3.6,4.1 7.6,7.3 14.2,13.1l-12 11 3.9 7c-22.3,11.5 -50.4,36.1 -66.7,58.1l-100.8 0c10,-18.6 16.3,-15.4 34.6,-24.1z" />
      <path d="M642.5 63.8c14.2,2.8 74.4,22.9 99.3,45.1l-4.7 5.1c21.2,13.8 86,68.9 83.3,91.8 -0.9,7.9 -28.2,-10.7 -26.2,-5.2 12.7,36 13.8,68 9.7,100.6 25.2,27.2 49.6,80.3 52.6,124.3 -16.1,9.8 -40.6,29.6 -56.4,52l-100.8 0c9.5,-18.1 12.8,-14.4 34.3,-24.6 12.8,-6 26.4,-18.4 25.1,-37.7 -43.2,-14.7 -62.4,-26.6 -96.5,-60.4 -36.6,8 -83.9,0.7 -111.6,-10.4l3 14.7c-27.7,-8.9 -53.2,-23.8 -73.5,-40.6l-85.8 -318.3c28.8,32.9 57.6,39 92.4,52l-3 5c17.9,5.1 27.6,7 46.9,9.9 23.2,-10.3 73.5,-17.8 114.6,-9.1l-2.7 6z" />
    </g>
  </svg>

  <!-- Text that appears when a side is active. The big headline is only for
       the eyes (the h1 above already says it), so screen readers skip it. -->
  <div class="copy copy-wild">
    <div class="container copy-inner">
      <p class="h1" aria-hidden="true">Built for<br />the wild</p>
      <p class="copy-text">Cold mornings, rough terrain, and days that take you further than expected. Gear for the unpredictable, designed to keep up when the conditions change and the way forward gets rough.</p>
    </div>
  </div>
  <div class="copy copy-anywhere">
    <div class="container copy-inner">
      <p class="h1" aria-hidden="true">Made for<br />anywhere</p>
      <p class="copy-text">From slow mornings to late nights, from familiar streets to somewhere new. Pieces that fit naturally into your everyday life, without asking you to dress for a different version of yourself.</p>
    </div>
  </div>
</section>

<style>
  .hero-split {
    /* All sizes are worked out from the hero height, so the photo cut
       always lines up with the cut in the bear */
    --hero-h: 45rem; /* 720px */
    --bear-h: calc(var(--hero-h) * 0.5); /* bear = 50% of the hero height */
    --bear-w: calc(var(--bear-h) * 1.794); /* width/height of the bear logo */
    /* Middle of the bear = middle of the part you see below the header */
    --bear-cy: calc((var(--hero-h) + var(--header-height)) / 2);
    /* The cut leans like the cut in the bear: 0.269 across for every 1 down.
       It runs through the middle of the bear, so we work out where it
       meets the top and the bottom of the hero. */
    --cut-top: calc(50% - var(--bear-cy) * 0.2692);
    --cut-bottom: calc(50% + (var(--hero-h) - var(--bear-cy)) * 0.2692);
    --gap: calc(var(--bear-w) * 0.019); /* half the width of the gap in the bear */
    --speed: 0.4s;

    position: relative;
    isolation: isolate; /* keeps the layers below inside the hero */
    container-type: inline-size; /* lets the glass layer measure the hero's width (cqi) */
    block-size: var(--hero-h);
    margin-block-start: calc(-1 * var(--header-height) - 1px); /* under the transparent header */
    overflow: hidden;
    background-color: var(--color-bg);
  }

  /* Soft dark fade at the top, so the header links stay readable on bright
     photos (fog, sky). Sits above the photos, below the bear and the text. */
  .hero-split::before {
    content: "";
    position: absolute;
    z-index: 1;
    inset-block-start: 0;
    inset-inline: 0;
    block-size: calc(var(--header-height) + var(--space-24)); /* 64 + 96 = 160px */
    background: linear-gradient(
      to bottom,
      color-mix(in srgb, var(--color-bg) 60%, transparent),
      color-mix(in srgb, var(--color-bg) 25%, transparent) 50%,
      transparent
    );
    pointer-events: none;
  }

  /* --- Photos --------------------------------------------------------------- */
  .side {
    position: absolute;
    inset: 0;
  }

  /* clip-path cuts each photo along the diagonal.
     The two cuts are --gap apart, so the background shows through as a line. */
  .side-wild {
    clip-path: polygon(
      0 0,
      calc(var(--cut-top) - var(--gap)) 0,
      calc(var(--cut-bottom) - var(--gap)) 100%,
      0 100%
    );
  }

  .side-anywhere {
    clip-path: polygon(
      calc(var(--cut-top) + var(--gap)) 0,
      100% 0,
      100% 100%,
      calc(var(--cut-bottom) + var(--gap)) 100%
    );
  }

  /* Each photo only fills the part of the hero where it is visible,
     so portrait photos work too (less of them is cut away). */
  .side-image {
    position: absolute;
    inset-block: 0;
    block-size: 100%;
    object-fit: cover;
    transition: opacity var(--speed) ease;
  }

  .side-wild .side-image {
    inset-inline-start: 0;
    inline-size: calc(max(var(--cut-top), var(--cut-bottom)) - var(--gap));
    object-position: var(--wild-focus);
  }

  .side-anywhere .side-image {
    inset-inline-end: 0;
    inline-size: calc(100% - min(var(--cut-top), var(--cut-bottom)) - var(--gap));
    object-position: var(--anywhere-focus);
  }

  /* --- Bear ----------------------------------------------------------------- */
  /* The bear and its glass layer sit in exactly the same box */
  .bear,
  .bear-glass {
    position: absolute;
    z-index: 1;
    inset-block-start: calc(var(--bear-cy) - var(--bear-h) / 2);
    inset-inline-start: calc(50% - var(--bear-w) * 0.5161); /* puts the bear's cut on the photo cut */
    block-size: var(--bear-h);
    inline-size: var(--bear-w);
    pointer-events: none; /* the mouse "sees" the photos through the bear */
  }

  /* Smoked glass bear:
     1. glass layer = the photos behind, blurred (see .glass-scene)
     2. dark tint on top (fill) = the "smoke"
     3. light edge that fades along the outline (stroke)
     4. thin light rim + soft dark shadow below, so it floats (filter) */
  .bear {
    filter: drop-shadow(0 0 1px color-mix(in srgb, var(--color-text) 40%, transparent))
      drop-shadow(0 12px 32px color-mix(in srgb, var(--color-bg) 60%, transparent));
  }

  .bear-glass {
    overflow: hidden;
    /* The logo file as a stencil: only where the bear is, the layer shows */
    mask: url(/logo/bear-light.svg) center / 100% 100% no-repeat;
  }

  /* Copy of the whole hero, moved back by the bear's position, so the
     blurred photos sit exactly over the real ones.
     100cqi = the hero's width (the hero is a "container", see above). */
  .glass-scene {
    position: absolute;
    inset-block-start: calc(-1 * (var(--bear-cy) - var(--bear-h) / 2));
    inset-inline-start: calc(-1 * (50cqi - var(--bear-w) * 0.5161));
    inline-size: 100cqi;
    block-size: var(--hero-h);
    filter: blur(12px) saturate(1.2) brightness(0.9);
  }

  .bear-half path {
    fill: color-mix(in srgb, var(--color-bg) 45%, transparent); /* the smoke tint */
    stroke: url(#bear-edge);
    stroke-width: 1.5px;
    vector-effect: non-scaling-stroke; /* line stays 1.5px, whatever the bear size */
    transition: fill var(--speed) ease;
  }

  /* --- Copy (headline, label) ----------------------------------------------- */
  .copy {
    position: absolute;
    z-index: 2;
    inset: 0;
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--speed) ease;
  }

  .copy-inner {
    display: flex;
    flex-direction: column;
    padding-block-start: calc(var(--header-height) + var(--space-8)); /* 32px below the header */
  }

  /* Hero headline a little smaller than a normal H1 (max 112px instead of 128px),
     so headline + text stay clear of the bear */
  .copy .h1 {
    font-size: clamp(3rem, 6vw + 1rem, 7rem);
    margin-block-end: var(--space-4); /* 16px to the text below */
  }

  /* Wild: text on the right (the city side goes dark). Anywhere: on the left. */
  .copy-wild .copy-inner {
    align-items: flex-end;
    text-align: end;
  }

  .copy-anywhere .copy-inner {
    align-items: flex-start;
  }

  /* Short text under the headline – narrow, so it stays clear of the bear.
     The space above comes from the headline's own 24px margin. */
  .copy-text {
    max-inline-size: 26ch;
    color: var(--color-text-secondary);
  }

  /* --- The two states ---------------------------------------------------------
     :has() asks "is something inside the hero hovered?".
     Wild is active when the forest photo is hovered. Then: city photo fades out,
     the city half of the bear turns into an outline, the wild copy fades in.
     Anywhere = the mirror image. */
  .hero-split:has(.side-wild:hover) {
    .side-anywhere .side-image {
      opacity: 0;
    }

    .bear-anywhere path {
      fill: transparent;
    }

    .copy-wild {
      opacity: 1;
    }
  }

  .hero-split:has(.side-anywhere:hover) {
    .side-wild .side-image {
      opacity: 0;
    }

    .bear-wild path {
      fill: transparent;
    }

    .copy-anywhere {
      opacity: 1;
    }
  }

  /* Reduced motion: states switch instantly, no fading */
  @media (prefers-reduced-motion: reduce) {
    .hero-split {
      --speed: 0s;
    }
  }
</style>
