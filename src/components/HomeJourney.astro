---
// HOME – THE JOURNEY SO FAR (from my Home anatomy, 31 Oct). Last Home section.
// Left: label, heading, intro, button to the footer newsletter, the questions line.
// Right: the real milestones + "Next up" (src/data/journey.js).
// Phones: text, milestones, then the questions line.
// No section numbers (decided 31 Oct).
// On the olive band (.band in global.css – version C, decided 31 Oct).
import { milestones, nextUp } from "../data/journey.js";
---

<section class="band section home-journey" aria-labelledby="home-journey-title">
  <div class="container">
  <div class="home-journey-inner">
    <div class="home-journey-text">
      <p class="label home-journey-label">The journey so far</p>
      <h2 id="home-journey-title">Still a concept. Getting real, step by step.</h2>
      <!-- Draft intro + button label – still open, change freely -->
      <p class="home-journey-intro">
        Cave Wear is still a concept, built step by step and in the open. Here is what has really happened so far –
        and what comes next.
      </p>
      <!-- ↓ = it jumps down the page (like "Write to us ↓" on /contact); the hint says
           where to, because "Follow the journey" alone didn't (31 Oct) -->
      <!-- data-look-here: the newsletter gets the FAQ's "look here" frame after the jump -->
      <a href="#newsletter" class="button button-outline" data-look-here>Follow the journey ↓</a>
      <!-- Two lines on every screen, so the hint is never wider than the button (31 Oct) -->
      <p class="small home-journey-hint">
        Newsletter and socials
        <span class="hint-line">down in the footer.</span>
      </p>
    </div>

    <ol class="home-journey-list" role="list">
      {
        milestones.map((milestone) => (
          <li class="milestone">
            <p class="milestone-date" aria-hidden="true">
              {milestone.day}
              <span>{milestone.month}</span>
            </p>
            <div>
              <h3 class="milestone-title">
                <span class="visually-hidden">{`${milestone.day} ${milestone.month}: `}</span>
                {milestone.title}
              </h3>
              <p class="small milestone-text">{milestone.text}</p>
            </div>
          </li>
        ))
      }
      <li class="milestone">
        <p class="milestone-date milestone-next" aria-hidden="true">
          Next
          <span>Up</span>
        </p>
        <div>
          <h3 class="milestone-title">
            <span class="visually-hidden">Next up: </span>
            {nextUp.title}
          </h3>
          <p class="small milestone-text">{nextUp.text}</p>
        </div>
      </li>
    </ol>

    <!-- The old "Questions?" block, merged into one quiet line (decided 31 Oct).
         Phones: under the milestones; desktop: left, under the button. -->
    <div class="home-journey-questions">
      <p>Got a question or an idea?</p>
      <ul class="home-journey-links" role="list">
        <li><a href="/contact#faq" class="text-link">Read the FAQ ›</a></li>
        <li><a href="/contact#contact-form" class="text-link">Write to us ›</a></li>
      </ul>
    </div>
  </div>
  </div>
</section>

<script src="../scripts/look-here.js"></script>

<style>
  /* Written mobile first: the base = phones (one column),
     "width >=" adds tablet and desktop. */

  /* Same inner line as the Base Collection (--home-inset, 48px from tablet up).
     Three parts: text, milestones, questions. Phones: in that order, one column.
     Desktop: text and questions left, the milestones right over both rows. */
  .home-journey-inner {
    display: grid;
    grid-template-areas:
      "text"
      "list"
      "questions";
    gap: var(--space-12); /* 48px between the parts on phones */

    @media (width >= 48rem) {
      padding-inline: var(--home-inset, var(--space-12));
    }

    /* Desktop: text left, milestones right (like the anatomy) */
    @media (width >= 64rem) {
      grid-template-areas:
        "text list"
        "questions list";
      grid-template-columns: 1fr 1.15fr;
      grid-template-rows: auto 1fr; /* the questions sit right under the text */
      gap: var(--space-12) var(--space-8); /* 48px down, 32px across */
    }
  }

  .home-journey-text {
    grid-area: text;
  }

  /* Label: Egret with a small square in front, like a tag (version C, 31 Oct).
     Not Wild Honey any more – that stays for things you can click. */
  .home-journey-label {
    margin-block-end: var(--space-2); /* 8px to the heading */
    color: var(--color-text);

    &::before {
      content: "";
      display: inline-block;
      inline-size: var(--space-2); /* 8px */
      block-size: var(--space-2);
      margin-inline-end: var(--space-2);
      background-color: currentColor;
      vertical-align: 1px;
    }
  }

  .home-journey-intro {
    margin-block-end: var(--space-6); /* 24px to the button */
    color: var(--color-text-secondary); /* Weathered Bone */
  }

  /* Quiet line under the button: where it takes you */
  .home-journey-hint {
    margin-block: var(--space-2) 0; /* 8px under the button */
    color: var(--color-text-quiet); /* Muted Stone */

    /* "down in the footer." on its own line */
    & .hint-line {
      display: block;
    }
  }

  /* --- Questions line: a hairline, one short sentence, two links in a row ----- */
  .home-journey-questions {
    grid-area: questions;
    align-self: start;
    padding-block-start: var(--space-6); /* 24px under the line */
    border-block-start: 1px solid var(--color-line); /* Charcoal */

    & p {
      margin-block-end: var(--space-2); /* 8px to the links */
    }
  }

  .home-journey-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-6); /* 24px between the two links */
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* --- Milestones: big number left, title + line right, hairline between ----- */
  .home-journey-list {
    grid-area: list;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .milestone {
    display: grid;
    grid-template-columns: var(--space-16) 1fr; /* 64px for the date */
    gap: var(--space-4); /* 16px */
    padding-block: var(--space-4); /* 16px */
    border-block-start: 1px solid var(--color-line);
  }

  /* The big date: Barlow Condensed like the H1 – the one display touch here */
  .milestone-date {
    margin: 0;
    color: var(--color-text); /* Egret – not clickable, so not Wild Honey (31 Oct) */
    font-family: var(--font-display);
    font-size: var(--space-8); /* 32px */
    font-weight: 700;
    line-height: 0.9;
    text-transform: uppercase;

    /* The month under the number, small */
    & span {
      display: block;
      margin-block-start: var(--space-1); /* 4px */
      font-family: var(--font-body);
      font-size: var(--text-small);
      font-weight: 500;
      line-height: 1;
      letter-spacing: var(--tracking-wide);
    }
  }

  /* "Next up": two words instead of a number, so a bit smaller */
  .milestone-next {
    font-size: var(--space-6); /* 24px */
  }

  .milestone-title {
    margin-block-end: var(--space-1); /* 4px – title and line belong together */
    font-size: var(--text-body);
    font-weight: 500;
    line-height: var(--leading-body);
    letter-spacing: -0.01em;
  }

  .milestone-text {
    margin-block-end: 0;
  }
</style>
