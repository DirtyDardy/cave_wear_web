---
// HOME – HOW THE PACK WORKS (my sketch, 1 Nov). Explains Reserve in 3 steps –
// honest: no payment, not an order.
// A dashed trail like on /contact, here lying down, from screen edge to screen edge.
// The numbers sit on it in circles that break the line. A Wild Honey dot walks along
// it once (src/scripts/pack-steps.js), the first time the section is on screen: the line
// behind it takes its colour, each number it reaches does too, and its text appears and stays.
// Without JavaScript and with reduced motion: no dot, all three texts simply stay.
import PackIcon from "../assets/icons/backpack.svg";

// The three cards wait for my animated technical drawings, in this order:
// button click · filling in name and email · email received notification
const steps = [
  { title: "Add to pack", text: "Pick a piece, a colour and your size. Your pack keeps it until you're ready." },
  { title: "Reserve", text: "No payment, no card. Send your pack as a reservation. Nothing is ordered." },
  { title: "Early access", text: "At launch, you hear from us first. Then you decide if you want to order." },
];
---

<section class="section home-pack" aria-labelledby="home-pack-title">
  <div class="container">
    <div class="home-pack-inner">
      <p class="label home-pack-label">How the Pack works</p>
      <h2 id="home-pack-title">Reserve your place. Pay nothing.</h2>
    </div>
  </div>

  <!-- The track is as wide as the screen (the trail runs off both edges), the steps
       stay on the Home content lines inside it -->
  <div class="pack-track">
    <div class="pack-walked" aria-hidden="true" hidden></div>
    <div class="pack-dot" aria-hidden="true" hidden></div>
    <div class="container">
      <ol class="pack-steps" role="list">
        {
          steps.map((step, index) => (
            <li class="pack-step">
              <span class="pack-number" aria-hidden="true">{index + 1}</span>
              <h3 class="pack-step-title">{step.title}</h3>
              <p class="small pack-step-text">{step.text}</p>
              <div class="pack-step-drawing"></div>
            </li>
          ))
        }
      </ol>
    </div>
  </div>

  <div class="container">
    <div class="home-pack-inner home-pack-foot">
      <div class="home-pack-note">
        <p class="home-pack-note-line">Not a shop yet. Reserving is a way of saying: I'd wear this.</p>
        <p class="small home-pack-note-small">Cave Wear is a concept. A reservation shows interest. It is not an order.</p>
      </div>

      <!-- Opens the Pack drawer, like the Pack button in the header. Needs JavaScript,
           so without it the button stays hidden (see below). -->
      <button
        type="button"
        class="button button-primary home-pack-open"
        aria-haspopup="dialog"
        aria-controls="pack-drawer"
      >
        <PackIcon class="home-pack-icon" />
        Open your pack
      </button>
    </div>
  </div>
</section>

<script src="../scripts/pack-steps.js"></script>

<style>
  /* Written mobile first: the base = phones (the trail runs down on the left),
     "width >=" lays it down across the screen for tablet and desktop. */

  /* The colour of the walked way (dot, line, reached numbers): Egret, because none of
     it is clickable (version C of Wild Honey, green and Egret, decided 1 Nov – the
     green line was hardly lighter than the grey one). And the time for one piece of
     the way – 0.8s is also MOVE_TIME in pack-steps.js. */
  .home-pack {
    --pack-progress: var(--color-text);
    --pack-move: 0.8s;
  }

  /* Same inner line as the other Home sections (--home-inset, 48px from tablet up) */
  .home-pack-inner {
    @media (width >= 48rem) {
      padding-inline: var(--home-inset, var(--space-12));
    }
  }

  .home-pack-label {
    margin-block-end: var(--space-2); /* 8px to the heading */
    color: var(--color-accent); /* Wild Honey, as in my sketch */
  }

  /* --- The track ---------------------------------------------------------------
     isolation = its own little stack of layers: trail at the bottom, the dot on it,
     the numbers on top – so the dot disappears behind a number and comes out again.
     overflow: hidden cuts the dot off at the screen edge when it walks in and out. */
  .pack-track {
    position: relative;
    isolation: isolate;
    margin-block: var(--space-6); /* 24px */
    padding-block: var(--space-6); /* 24px of trail above the first and under the last number */
    overflow: hidden;

    /* Tablet and desktop */
    @media (width >= 48rem) {
      margin-block: var(--space-12) var(--space-16); /* 48px above, 64px below */
      padding-block: 0;
    }
  }

  /* The trail: same as /contact – 1px, 8px dash, 8px gap. On phones it runs down
     through the middle of the 32px circles. Two lines lie exactly on top of each
     other, with the same dashes: the grey one, and the coloured one. */
  .pack-track::before,
  .pack-walked {
    position: absolute;
    inset-block: 0;
    inset-inline-start: calc(var(--gutter) + var(--space-4));
    inline-size: 1px;
    background-image: repeating-linear-gradient(
      to bottom,
      var(--trail-colour) 0 var(--space-2),
      transparent var(--space-2) var(--space-4)
    );

    /* Tablet and desktop: across the whole screen, through the middle of the circles */
    @media (width >= 48rem) {
      inset-block: var(--space-4) auto;
      inset-inline: 0;
      inline-size: auto;
      block-size: 1px;
      background-image: repeating-linear-gradient(
        to right,
        var(--trail-colour) 0 var(--space-2),
        transparent var(--space-2) var(--space-4)
      );
    }
  }

  .pack-track::before {
    content: "";
    --trail-colour: var(--color-input-border); /* Flint */
  }

  /* clip-path = show only a part of an element. The script cuts the coloured line
     off where the dot is, and it slides along at the dot's speed. */
  .pack-walked {
    --trail-colour: var(--pack-progress);
    transition: clip-path var(--pack-move) var(--motion-ease);
  }

  /* The dot: the end marker from /contact (a ring with a dot). The script moves it
     with transform. */
  .pack-dot {
    position: absolute;
    inset-block-start: 0;
    inset-inline-start: 0;
    z-index: 1;
    inline-size: calc(var(--space-4) + 2px); /* 18px */
    block-size: calc(var(--space-4) + 2px);
    border: 1.5px solid var(--pack-progress);
    border-radius: var(--radius-full);
    background: radial-gradient(circle, var(--pack-progress) 3px, var(--color-bg) 3.5px);
    translate: -50% -50%;
    transition: transform var(--pack-move) var(--motion-ease);
  }

  /* --- The steps --------------------------------------------------------------- */
  .pack-steps {
    display: grid;
    gap: var(--space-8); /* 32px between the steps on phones */
    margin: 0;
    padding: 0;
    list-style: none;

    @media (width >= 48rem) {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-6); /* 24px between the columns */
      padding-inline: var(--home-inset, var(--space-12));
    }

    @media (width >= 64rem) {
      gap: var(--space-12); /* 48px, as in my sketch */
    }
  }

  /* Phones: number left, title and text right */
  .pack-step {
    display: grid;
    grid-template-columns: var(--space-8) 1fr;
    column-gap: var(--space-4); /* 16px */

    /* Tablet and desktop: everything centred under the number (my sketch). The text's
       row takes any extra height, so a shorter text doesn't move its title and the
       three drawing tiles always start on one line. */
    @media (width >= 48rem) {
      grid-template-columns: 1fr;
      grid-template-rows: auto auto 1fr auto;
      justify-items: center;
      text-align: center;
    }
  }

  /* The circle breaks the trail: it has the page's background. It starts grey and
     takes the colour when the dot reaches it (data-reached, set by the script). */
  .pack-number {
    position: relative;
    z-index: 2;
    grid-row: 1 / span 2;
    display: grid;
    place-items: center;
    inline-size: var(--space-8); /* 32px */
    block-size: var(--space-8);
    border: 1px solid var(--color-input-border); /* Flint */
    border-radius: var(--radius-full);
    background-color: var(--color-bg);
    color: var(--color-text-quiet); /* Muted Stone */
    font-size: var(--text-small);
    line-height: 1;
    transition:
      color var(--motion-duration) var(--motion-ease),
      border-color var(--motion-duration) var(--motion-ease);

    @media (width >= 48rem) {
      grid-row: auto;
      margin-block-end: var(--space-4); /* 16px to the title */
    }
  }

  .pack-step[data-reached] .pack-number {
    border-color: var(--pack-progress);
    color: var(--pack-progress);
  }

  .pack-step-title {
    margin-block: var(--space-1); /* 4px – lines up with the middle of the circle */
    font-size: var(--text-body);
    font-weight: 500;
    line-height: var(--leading-body);
    letter-spacing: -0.01em;

    @media (width >= 48rem) {
      margin-block: 0 var(--space-2); /* 8px to the text */
    }
  }

  /* The title is always there. A text appears when the dot reaches its number
     (data-reached) and then stays. Only opacity changes: the text keeps its space,
     so nothing jumps, and screen readers can always read it. */
  .pack-step-text {
    grid-column: 2;
    margin-block-end: 0; /* the card sets the space below */
    transition: opacity var(--motion-duration) var(--motion-ease);

    @media (width >= 48rem) {
      grid-column: auto;
      max-inline-size: 16rem; /* 256px */
      text-wrap: balance;
    }
  }

  .home-pack[data-running] .pack-step:not([data-reached]) .pack-step-text {
    opacity: 0;
  }

  /* The card for my technical drawing: stripes, 12px corners, 5:4 as in my sketch. The
     final look is the 1px Flint outline. While it waits for the dot, the outline is
     dimmer (Charcoal) and comes up together with its number – never lighter than Flint. */
  .pack-step-drawing {
    grid-column: 2;
    inline-size: 100%;
    aspect-ratio: 5 / 4;
    margin-block-start: var(--space-8); /* 32px under the text on phones */
    border: 1px solid var(--color-input-border);
    border-radius: var(--radius-button);
    background: repeating-linear-gradient(
      135deg,
      var(--color-bg) 0 var(--space-2),
      var(--color-surface) var(--space-2) var(--space-4)
    );
    transition: border-color var(--motion-duration) var(--motion-ease);

    @media (width >= 48rem) {
      grid-column: auto;
      margin-block-start: var(--space-12); /* 48px */
    }
  }

  .home-pack[data-running] .pack-step:not([data-reached]) .pack-step-drawing {
    border-color: var(--color-line);
  }

  /* --- Under the steps: two lines, the button next to them ---------------------- */
  .home-pack-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4) var(--space-6); /* 16px down, 24px across */
  }

  .home-pack-note {
    flex: 1 1 100%; /* phones: a line of its own */

    @media (width >= 48rem) {
      flex: 0 1 auto;
    }
  }

  .home-pack-note-line {
    margin-block-end: var(--space-1); /* 4px */
    font-size: var(--text-small);
    font-weight: 500;
    line-height: var(--leading-small);
  }

  .home-pack-note-small {
    color: var(--color-text-quiet); /* Muted Stone */
  }

  .home-pack-open {
    gap: var(--space-2); /* 8px between icon and text */
  }

  .home-pack-icon {
    inline-size: var(--space-6); /* 24px, like in the header */
    block-size: var(--space-6);
  }

  /* No JavaScript = no drawer, so no button that does nothing */
  :global(html:not([data-js])) .home-pack-open {
    display: none;
  }
</style>
