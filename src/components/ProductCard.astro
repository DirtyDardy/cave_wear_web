---
// PRODUCT CARD (from my products sketch) – 4:5 photo, name, short line, colour
// dots, fit icons. Optional second photo that fades in on hover.
// The heart saves the product as a favorite (src/scripts/favorites.js).
// Clicking (decided 25 Oct): the whole card opens the product page; a colour dot
// or fit icon opens it with that colour / fit already chosen.
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { toColour } from "../data/products";
import HeartIcon from "../assets/icons/heart.svg";
import FitUnisexIcon from "../assets/icons/fit-unisex.svg";
import FitFemaleIcon from "../assets/icons/fit-female.svg";
import FitMaleIcon from "../assets/icons/fit-male.svg";

type Fit = "unisex" | "female" | "male";

interface Props {
  id: string; // short, unique, never changes – e.g. "core-tee". Favorites are saved by it.
  name: string;
  tagline: string;
  image: ImageMetadata;
  alt: string;
  hoverImage?: ImageMetadata; // shown on hover – leave out for no hover photo
  href?: string; // the product page – leave out for placeholder cards (then nothing is clickable)
  colours?: ReturnType<typeof toColour>[]; // leave out → the three placeholder dots
  fits?: Fit[]; // leave out → no fit icons
}

const {
  id,
  name,
  tagline,
  image,
  alt,
  hoverImage,
  href,
  colours = ["Black", "Olive", "Egret"].map(toColour),
  fits = [],
} = Astro.props;

const fitIcons = { unisex: FitUnisexIcon, female: FitFemaleIcon, male: FitMaleIcon };
const fitLabels = { unisex: "Unisex", female: "Female", male: "Male" };

// One size list for both photos: the browser picks the smallest file that is
// still sharp. "sizes" tells it how wide a card is: 1/3 of the screen on
// desktop, 1/2 on tablets, full width on phones.
const widths = [400, 800, 1200];
const sizes = "(width >= 64rem) 33vw, (width >= 40rem) 50vw, 100vw";
---

<article class="product-card" data-product-id={id}>
  <div class="product-media">
    <Image src={image} alt={alt} class="product-image" widths={widths} sizes={sizes} />
    {hoverImage && <Image src={hoverImage} alt="" class="product-image product-image-hover" widths={widths} sizes={sizes} />}

    <!-- Fit icons, top left – each opens the product page with that fit chosen -->
    {
      href && fits.length > 0 && (
        <ul class="fits" role="list" aria-label="Fits">
          {fits.map((fit) => {
            const FitIcon = fitIcons[fit];
            return (
              <li>
                <a href={`${href}?fit=${fit}`} class="fit-link">
                  <FitIcon class="fit-icon" />
                  <span class="visually-hidden">{`${name}, ${fitLabels[fit]} fit`}</span>
                </a>
              </li>
            );
          })}
        </ul>
      )
    }

    <!-- Toggle button: aria-pressed tells screen readers if it's on ("true") or off ("false").
         favorites.js switches it. -->
    <button type="button" class="favorite-button" aria-label={`Favorite ${name}`} aria-pressed="false">
      <HeartIcon class="favorite-icon" />
    </button>
  </div>

  <div class="product-info">
    <!-- The name link is stretched over the whole card (see CSS) – so a click
         anywhere on the card opens the product page -->
    <h3 class="product-name">{href ? <a href={href} class="card-link">{name}</a> : name}</h3>
    <p class="small product-tagline">{tagline}</p>
    <ul class="swatches" role="list" aria-label="Colours">
      {
        colours.map((colour) => (
          <li>
            {href ? (
              <a
                href={`${href}?colour=${colour.file}`}
                class="swatch"
                style={`--swatch: ${colour.hex}`}
                data-very-dark={colour.veryDark ? "" : undefined}
              >
                <span class="visually-hidden">{`${name} in ${colour.name}`}</span>
              </a>
            ) : (
              <span class="swatch" style={`--swatch: ${colour.hex}`} data-very-dark={colour.veryDark ? "" : undefined}>
                <span class="visually-hidden">{colour.name}</span>
              </span>
            )}
          </li>
        ))
      }
    </ul>
  </div>
</article>

<style>
  /* Dark Obsidian, like the page (decided 24 Oct), sharp corners (card radius
     is still open). The 1px Charcoal line around it – the same line as under
     the collection titles – is what shows the card's edge. */
  .product-card {
    position: relative; /* the stretched link below covers exactly this box */
    display: flex;
    flex-direction: column;
    block-size: 100%; /* all cards in a row are equally tall */
    border: 1px solid var(--color-line);
    background-color: var(--color-bg);
  }

  /* --- Whole card clickable ("stretched link") ------------------------------
     A link inside a link isn't allowed in HTML, so the card can't be one big
     link around the dots. Instead the name link gets an invisible layer
     (::after) that covers the whole card. The heart, fit icons and dots get
     z-index: 1, so they lie above that layer and keep their own clicks. */
  .card-link {
    color: inherit; /* the name stays Egret, not link colour */

    &::after {
      content: "";
      position: absolute;
      inset: 0;
    }

    /* Keyboard focus: ring around the whole card instead of only the name */
    &:focus-visible {
      outline: none;
    }
  }

  .product-card:has(.card-link:focus-visible) {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  /* --- Photo ------------------------------------------------------------- */

  /* 8px of Dark Obsidian around the photo (top and sides) – a frame, as in the sketch */
  .product-media {
    position: relative;
    aspect-ratio: 4 / 5;
    margin: var(--space-2) var(--space-2) 0;
    overflow: hidden;
  }

  .product-image {
    position: absolute;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }

  /* Second photo lies on top of the first, invisible until hover */
  .product-image-hover {
    opacity: 0;
    transition: opacity 0.4s ease; /* same speed as the hero */
  }

  /* Only on devices with a real mouse – on phones a tap would leave it stuck.
     :focus-within = also when the heart button has keyboard focus. */
  @media (hover: hover) {
    .product-card:hover .product-image-hover {
      opacity: 1;
    }
  }

  .product-card:focus-within .product-image-hover {
    opacity: 1;
  }

  /* The heart button (.favorite-button) is styled in global.css –
     the product page uses the same one. Here it only needs to lie above the
     stretched link. */
  .favorite-button {
    z-index: 1;
  }

  /* --- Fit icons ---------------------------------------------------------------
     Top left, same smoked glass as the heart but smaller (32px) and more subtle:
     fainter edge, no shadow. Dardan's symbol fills the circle, so the ring is centred. */
  .fits {
    position: absolute;
    z-index: 1;
    inset-block-start: var(--space-3); /* 12px from the photo edge, like the heart */
    inset-inline-start: var(--space-3);
    display: flex;
    gap: var(--space-1); /* 4px */
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .fit-link {
    display: grid;
    place-items: center;
    inline-size: var(--space-8); /* 32px */
    block-size: var(--space-8);
    border: 0.5px solid color-mix(in srgb, var(--color-text) 15%, transparent);
    border-radius: var(--radius-full);
    background-color: color-mix(in srgb, var(--color-bg) 45%, transparent);
    color: var(--color-text);
    -webkit-backdrop-filter: blur(12px) saturate(1.2) brightness(0.9); /* older Safari */
    backdrop-filter: blur(12px) saturate(1.2) brightness(0.9);
    transition: background-color 0.2s ease;

    &:hover {
      background-color: color-mix(in srgb, var(--color-bg) 60%, transparent);
      color: var(--color-text);
    }
  }

  .fit-icon {
    inline-size: 100%;
    block-size: 100%;
  }

  /* --- Text ------------------------------------------------------------------ */

  /* Centred, as in the sketch. 24px space around the text. */
  .product-info {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: center;
    padding: var(--space-6);
    text-align: center;
  }

  .product-name {
    margin-block-end: var(--space-1); /* 4px – name and line belong together */
  }

  .product-tagline {
    margin-block-end: var(--space-6); /* 24px to the colour dots */
  }

  /* --- Colour dots ---------------------------------------------------------- */

  .swatches {
    display: flex;
    gap: var(--space-2); /* 8px */
    margin: 0;
    margin-block-start: auto; /* dots sit at the bottom, even with a longer text */
    padding: 0;
    list-style: none;
  }

  /* Product colours from the shared list (src/data/product-colours.js).
     As links they lie above the stretched link (z-index needs position). */
  .swatch {
    position: relative;
    z-index: 1;
    display: block;
    inline-size: var(--space-6); /* 24px */
    block-size: var(--space-6);
    border-radius: var(--radius-full);
    background-color: var(--swatch);

    /* Black and similar get a Flint ring, otherwise they vanish on the dark card */
    &[data-very-dark] {
      box-shadow: inset 0 0 0 1px var(--color-flint);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .product-image-hover,
    .fit-link {
      transition: none;
    }
  }
</style>
