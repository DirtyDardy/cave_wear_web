---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

// Each page passes its own title and description to this layout.
interface Props {
  title: string;
  description?: string;
  noindex?: boolean; // true = search engines should not list this page
}

const {
  title,
  noindex = false,
  description = "Cave Wear – Rugged. Functional. Refined. Outdoor clothing that also looks right in the city.",
} = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{`${title} | Cave Wear`}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#0d0d0e" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preload" href="/fonts/Geist-Variable.woff2" as="font" type="font/woff2" crossorigin />
    <!-- Marks the page as "JavaScript works" before anything is drawn.
         CSS uses this so the mobile menu never flashes open on load. -->
    <script is:inline>document.documentElement.dataset.js = "";</script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
