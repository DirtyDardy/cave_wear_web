---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import PageSwipe from "../components/PageSwipe.astro";

// Each page passes its own title and description to this layout.
interface Props {
  title: string;
  description?: string;
  noindex?: boolean; // true = search engines should not list this page
}

const {
  title,
  noindex = false,
  description = "Cave Wear – Rugged. Functional. Refined. Outdoor clothing that also looks right in the city.",
} = Astro.props;

const pageTitle = `${title} | Cave Wear`;

// The page's one official address, always with the "/" at the end like the live site.
// Astro.site = the address in astro.config.mjs.
const path = Astro.url.pathname.endsWith("/") ? Astro.url.pathname : `${Astro.url.pathname}/`;
const pageUrl = new URL(path, Astro.site);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={pageUrl} />
    <!-- What a shared link shows (Open Graph: WhatsApp, LinkedIn, Slack …) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Cave Wear" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={new URL("/og-image.jpg", Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="A person standing in the mouth of a cave, looking out at a misty forest." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#0d0d0e" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preload" href="/fonts/Geist-Variable.woff2" as="font" type="font/woff2" crossorigin />
    <!-- Marks the page as "JavaScript works" before anything is drawn.
         CSS uses this so the mobile menu never flashes open on load. -->
    <script is:inline>document.documentElement.dataset.js = "";</script>
    <PageSwipe />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
