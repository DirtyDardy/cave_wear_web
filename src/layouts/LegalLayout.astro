---
// Layout for the legal pages (Impressum, Privacy Policy).
// Only uses the design system: H1, lead, H2, H3, body text, links – plus a few
// rules for lists and addresses that only legal texts need.
import BaseLayout from "./BaseLayout.astro";
import { legalUpdated } from "../data/owner.js";

interface Props {
  title: string;
  lead: string;
  description?: string;
}

const { title, lead, description } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <article class="container section legal">
    <h1>{title}</h1>
    <p class="lead">{lead}</p>
    <p class="small">Last updated: {legalUpdated}</p>

    <slot />
  </article>
</BaseLayout>

<style>
  /* :global() because the content comes from the page through <slot /> */

  /* Legal headings stay real H2/H3 (structure for screen readers and Google),
     but look quieter: medium weight instead of extra-bold, one size smaller –
     a page for legal things only, like the legal pages of Linear and Vercel
     (decided 26 Oct; before, the H2s were 48px extra-bold).
     The text under them is one step quieter (Weathered Bone). */
  .legal :global(:is(h2, h3)) {
    font-weight: 500;
    letter-spacing: 0;
  }

  .legal :global(h2) {
    margin-block: var(--space-12) var(--space-3); /* 48px above, 12px to its text */
    font-size: var(--text-h3); /* 24px */
    line-height: var(--leading-h3);
  }

  .legal :global(h3) {
    margin-block: var(--space-6) var(--space-1); /* 24px above, 4px to its text */
    font-size: var(--text-body);
    line-height: var(--leading-body);
  }

  .legal :global(:is(p:not(.lead, .small), li, address)) {
    color: var(--color-text-secondary);
  }

  .legal :global(:is(ul, ol)) {
    max-inline-size: var(--measure-body);
    margin-block: 0 var(--space-4);
    padding-inline-start: var(--space-6);
  }

  .legal :global(li + li) {
    margin-block-start: var(--space-2);
  }

  /* Links in lists get the same semi-bold as links in running text (WCAG 1.4.1) */
  .legal :global(li a) {
    font-weight: 600;
  }

  /* Browsers show <address> in italics – the design system doesn't use italics */
  .legal :global(address) {
    margin-block-end: var(--space-4);
    font-style: normal;
  }

  /* Small "Photo credits" toggle at the end of the Impressum.
     <summary> is the clickable line; the list only shows when it's open. */
  .legal :global(.credits) {
    margin-block-start: var(--space-16); /* 64px */
    color: var(--color-text-secondary);
    font-size: var(--text-small);
    line-height: var(--leading-small);
  }

  .legal :global(.credits summary) {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-accent);
    font-weight: 600;
    list-style: none; /* hides the browser's own triangle … */
    cursor: pointer;

    &:hover {
      color: var(--color-accent-hover);
    }
  }

  .legal :global(.credits summary::-webkit-details-marker) {
    display: none; /* … also in Safari */
  }

  /* Own small sign: "+" when closed, "–" when open */
  .legal :global(.credits summary::after) {
    content: "+";
  }

  .legal :global(.credits[open] summary::after) {
    content: "–";
  }

  .legal :global(.credits ul) {
    margin-block-start: var(--space-4);
  }

  /* Visible note for details that are still missing (see src/data/owner.js) */
  .legal :global(.missing) {
    color: var(--color-text-quiet);
  }
</style>
