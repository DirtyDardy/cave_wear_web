---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroSplit from "../components/HeroSplit.astro";
import HomePrinciples from "../components/HomePrinciples.astro";
import HomeCollection from "../components/HomeCollection.astro";
import HomePack from "../components/HomePack.astro";
import HomeConditions from "../components/HomeConditions.astro";
import HomeJourney from "../components/HomeJourney.astro";
---

<BaseLayout title="Home">
  <HeroSplit wildFocus="center 70%" anywhereFocus="center 60%" />

  <!-- One button, centred on the hero's bottom edge (decided 30 Oct, from Wild Honey,
       glass, glass + glow and glass + light). "Explore more ↓" is gone: the hero is
       never taller than 90% of the screen, so the next section always peeks in –
       no need for a button that scrolls to it. Label is a placeholder. -->
  <div class="container hero-cta">
    <a href="/products" class="button button-glass">Discover the collection</a>
  </div>

  <!-- Rugged · Functional · Refined: three tiles (video placeholders for now) -->
  <HomePrinciples />

  <!-- Base Collection: Field Hoodie big, Core Tee + Ridge Beanie small (31 Oct) -->
  <HomeCollection />

  <!-- How the Pack works: the dot walks along the numbers (my sketch, 1 Nov) -->
  <HomePack />

  <!-- Field conditions: a moving map of Europe, Regensburg's real weather by default (1 Nov) -->
  <HomeConditions />

  <!-- Last section before the footer: real milestones + "Next up". The old
       "Questions?" block is merged into it as one line (decided 31 Oct). -->
  <HomeJourney />
  <!-- The style guide is no longer linked from Home – open it directly: /styleguide -->
</BaseLayout>

<style>
  /* Centred on the hero's bottom edge: the button moves up by half its height,
     so its top half lies over the photo – there the smoked glass really blurs
     something. The space below comes from the next section. */
  .hero-cta {
    /* One step bigger than every other button (decided 30 Oct): +4px in height
       (44px with a mouse, 48px on touch screens), 20px sides, 16px text */
    --hero-cta-height: calc(var(--control-height) + var(--space-1));

    position: relative;
    z-index: 3; /* above the hero */
    display: flex;
    justify-content: center;
    margin-block-start: calc(-1 * var(--hero-cta-height) / 2);
  }

  /* Stronger glass (decided 30 Oct, from plain glass, glow, shine and sharp
     corners): a brighter full 1px edge and a faint Egret fill, so the button
     lifts off the dark – no shine, no glow. Corners stay the button radius. */
  .hero-cta .button-glass {
    block-size: var(--hero-cta-height);
    padding-inline: calc(var(--space-4) + var(--space-1)); /* 20px */
    border: 1px solid var(--glass-edge-hover);
    background-color: color-mix(in srgb, var(--color-text) 8%, transparent);
    font-size: var(--text-body); /* 16px */

    /* Hover (mouse only): the fill gets a little lighter instead of darker */
    @media (hover: hover) {
      &:hover:not(:disabled) {
        border-color: var(--glass-edge-hover);
        background-color: color-mix(in srgb, var(--color-text) 14%, transparent);
      }
    }
  }
</style>
