---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import StyleGuide from "../components/StyleGuide.astro";
import heroImage from "../assets/test/placeholder.jpg";
---

<BaseLayout title="Home">
  <!-- TEMPORARY hero – placeholder image until the final hero is decided -->
  <section class="hero">
    <Image
      src={heroImage}
      alt=""
      class="hero-image"
      width={2400}
      widths={[640, 1024, 1600, 2400]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />
    <div class="container hero-content">
      <h1>Cave Wear</h1>
    </div>
  </section>

  <!-- TEMPORARY: style guide below the hero, for testing the design and scrolling -->
  <StyleGuide />

</BaseLayout>

<style>
  /* 720px high, pulled up under the header so it shows through */
  .hero {
    position: relative;
    display: grid;
    align-items: end;
    block-size: 45rem; /* 720px */
    margin-block-start: calc(-1 * var(--header-height));
    padding-block-end: var(--space-16);
    overflow: hidden;
  }

  /* The image fills the whole hero, cropped instead of stretched */
  .hero-image {
    position: absolute;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }

  /* Text sits on top of the image */
  .hero-content {
    position: relative;
  }
</style>
