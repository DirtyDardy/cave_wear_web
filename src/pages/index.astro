---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroSplit from "../components/HeroSplit.astro";
---

<BaseLayout title="Home">
  <HeroSplit wildFocus="center 70%" anywhereFocus="center 60%" />

  <!-- PLACEHOLDER call to action: final text and position still open
       (see CLAUDE.md, section 11). Sits right under the hero, so it is always
       visible on load – the hero is never taller than 90% of the screen. -->
  <div class="container hero-cta">
    <a href="/products" class="button button-primary">Call to action</a>
  </div>
  <!-- Closing section: last thing before the footer. Points straight to the
       FAQ and the contact form (on /contact they need id="faq" and id="contact-form"). -->
  <section class="container section home-contact" aria-labelledby="home-contact-title">
    <h2 id="home-contact-title">Questions?</h2>
    <p>Read the FAQ or write to us.</p>
    <div class="home-contact-buttons">
      <a href="/contact#faq" class="button button-primary">FAQ</a>
      <a href="/contact#contact-form" class="button button-outline">Write to us</a>
    </div>
  </section>
  <!-- The style guide is no longer linked from Home – open it directly: /styleguide -->
</BaseLayout>

<style>
  /* Centred under the hero, close to it, so it reads as part of the hero.
     The space below comes from the next section. */
  .hero-cta {
    display: flex;
    justify-content: center;
    padding-block-start: var(--space-8); /* 32px */
  }

  /* Centred, like the hero button above it */
  .home-contact {
    text-align: center;

    & p {
      margin-inline: auto;
      margin-block-end: var(--space-6); /* 24px to the buttons */
    }
  }

  /* Both buttons side by side, centred; stacked if there's no room */
  .home-contact-buttons {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-4); /* 16px */
  }
</style>
