---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroSplit from "../components/HeroSplit.astro";
---

<BaseLayout title="Home">
  <HeroSplit wildFocus="center 70%" anywhereFocus="center 60%" />

  <!-- TEMPORARY: way into the style guide while the site is being built -->
  <section class="container section">
    <a href="/styleguide" class="test-link">Style guide</a>
  </section>
</BaseLayout>

<style>
  /* TEMPORARY link – outlined, so it doesn't look like a final design */
  .test-link {
    display: inline-flex;
    align-items: center;
    block-size: var(--space-12); /* 48px */
    padding-inline: var(--space-6);
    border: 1px solid var(--color-accent);
    color: var(--color-accent);
    text-decoration: none;

    &:hover {
      border-color: var(--color-accent-hover);
      color: var(--color-accent-hover);
    }
  }
</style>
