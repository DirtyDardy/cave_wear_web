---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Home">
  <!-- TEMPORARY hero placeholder – replaced by the real hero image -->
  <section class="hero">
    <div class="container">
      <h1>Cave Wear</h1>
      <p class="hero-note">Hero image placeholder</p>
    </div>
  </section>
</BaseLayout>

<style>
  /* Full screen, pulled up under the header so it shows through */
  .hero {
    display: grid;
    align-items: end;
    min-block-size: 100dvh;
    margin-block-start: calc(-1 * var(--header-height));
    padding-block: var(--space-24) var(--space-16);
    background: linear-gradient(160deg, var(--color-brand-support), var(--color-bg) 75%);
  }

  .hero-note {
    margin: 0;
    color: var(--color-text);
  }
</style>
