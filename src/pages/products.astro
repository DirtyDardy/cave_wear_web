---
// PRODUCTS (from my products sketch): photo header, Base Collection,
// Supporter Collection, Favorites.
// Every product folder in src/content/products/ becomes a card here by itself.
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import ProductCard from "../components/ProductCard.astro";
import Coordinates from "../components/Coordinates.astro";
import { getProducts, type Product } from "../data/products";
import heroImage from "../assets/products/products-hero.jpg";
import supporterPrint from "../assets/products/supporter-print.webp";

const products = await getProducts();

// A product folder → what the card needs. Photo + hover photo: shot 0 + shot 1,
// without shot 0: shot 1 + shot 2 (first colour and fit).
function toCard(product: Product) {
  return {
    id: product.id,
    name: product.name,
    tagline: product.tagline,
    image: product.card.image,
    alt: product.card.alt,
    hoverImage: product.cardHover.image,
    href: `/products/${product.id}`,
    colours: product.colours,
    fits: product.fits,
  };
}

// One collection's cards, in the order of the folder numbers
function cardsFor(collection: Product["collection"]) {
  return products.filter((product) => product.collection === collection).map(toCard);
}

const baseCollection = cardsFor("Base Collection");
const supporterCollection = cardsFor("Supporter Collection");
---

<BaseLayout
  title="Products"
  description="The Base Collection and the Supporter Collection: concept pieces made to last. Nothing is for sale. Reserve your place for the launch."
>
  <!-- Photo header: trees in front of a city – the wild and anywhere in one picture.
       top-fade: soft dark fade at the top for the header (global.css) -->
  <section class="products-hero top-fade">
    <Image
      src={heroImage}
      alt=""
      class="products-hero-image"
      widths={[640, 1024, 1600, 2000]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />
    <div class="container products-hero-inner">
      <h1>Products</h1>
    </div>
  </section>

  <div class="container section collections">
    <!-- id: the Pack's "Discover the collection" jumps here (/products#base-collection) -->
    <section id="base-collection" class="collection" aria-labelledby="base-title">
      <!-- Title + quiet tag line (same look as the product code), then the short intro.
           The intro is folded away behind the small button on the right of the title
           (description-toggle.js, same button as on the product page). Without
           JavaScript: no button, the intro is always there. -->
      <div class="collection-head">
        <div class="collection-title-row">
          <h2 id="base-title" class="label collection-title">Base Collection</h2>
          <button
            type="button"
            class="description-toggle"
            aria-expanded="false"
            aria-controls="base-intro"
            aria-label="About the Base Collection"
          ></button>
        </div>
        <p class="collection-tags"><span>Tone on tone</span> · <span>Made to last</span> · <span>Built for anywhere</span></p>
      </div>
      <p id="base-intro" class="collection-intro">
        Essentials made for years, not seasons. Buy once, keep it. The collection grows one
        considered piece at a time.{" "}
        <a href="/brand" class="text-link">Why Cave Wear exists ›</a>
      </p>
      <ul class="product-grid" role="list">
        {
          baseCollection.map((product) => (
            <li>
              <ProductCard {...product} />
            </li>
          ))
        }
      </ul>
    </section>

    <section class="collection" aria-labelledby="supporter-title">
      <!-- The donation is only planned → "Conservation planned", never "Supports conservation"
           until it's real -->
      <div class="collection-head">
        <h2 id="supporter-title" class="label collection-title">Supporter Collection</h2>
        <p class="collection-tags"><span>Pre-launch only</span> · <span>For early believers</span> · <span>Conservation planned</span></p>
      </div>
      <ul class="product-grid" role="list">
        {
          supporterCollection.map((product) => (
            <li>
              <ProductCard {...product} />
            </li>
          ))
        }
        <!-- Text card in the third column: what the Supporter Collection is. -->
        <li class="text-card">
          <h3>For the ones who were here first.</h3>
          <Image
            src={supporterPrint}
            alt="The Supporter back print: a cave bear, head down, half skeleton and half outline"
            class="text-card-print"
            widths={[320, 640, 960]}
            sizes="(width >= 64rem) 20vw, (width >= 40rem) 40vw, 75vw"
          />
          <p class="small">
            The print shows Ursus spelaeus, the cave bear, named by Rosenmüller in 1794. Half
            skeleton, half outline: the bones are all that's left of it.
          </p>
          <p class="small">
            A tee and a hoodie, reservable only before the launch – then gone for good. Every
            piece is planned to support what you choose: bears, Cave Wear or both.
          </p>
        </li>
      </ul>
    </section>

    <!-- Filled by favorites.js: a copy of every card whose heart is on.
         The list starts hidden; the text shows until there's a favorite. -->
    <section aria-labelledby="favorites-title">
      <h2 id="favorites-title" class="label collection-title">Favourites</h2>
      <ul id="favorites-list" class="product-grid" role="list" hidden></ul>
      <p id="favorites-empty" class="small favorites-empty">No favourites yet. Click the heart on a product to keep it here.</p>

      <!-- Gjilan, my birth city. It moved here on 2 Nov, so the Brand page can have
           Brente Holme, where my story starts. -->
      <div class="favorites-coordinates">
        <Coordinates place="gjilan" />
      </div>
    </section>
  </div>
</BaseLayout>

<script src="../scripts/favorites.js"></script>
<script src="../scripts/description-toggle.js"></script>
<style>
  /* --- Photo header ------------------------------------------------------------
     Same height as the Home hero, but 60% of the screen on phones
     (--photo-header-height, global.css), full width, under the transparent
     header – like Home. */
  .products-hero {
    position: relative;
    block-size: var(--photo-header-height);
    margin-block-start: calc(-1 * var(--header-height) - 1px); /* under the transparent header */
    overflow: hidden;
  }

  /* Vertical position 70% (50% = centre, 100% = bottom edge, decided 24 Oct):
     the forest always stays in view, the skyline is cut away first on short
     or narrow screens. */
  .products-hero-image {
    position: absolute;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    object-position: center 70%;
  }

  /* H1 centred near the bottom, over the trees (dark = readable).
     z-index 2 = above the top fade. */
  .products-hero-inner {
    position: absolute;
    z-index: 2;
    inset: 0;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding-block-end: var(--space-16); /* 64px */
    text-align: center;
  }

  /* --- Collections ------------------------------------------------------------ */

  /* 96px between the three collections (same as the space around a section) */
  .collections {
    display: flex;
    flex-direction: column;
    gap: var(--section-space);
  }

  /* A jump from the Pack (/products#base-collection) lands 24px below the header */
  .collection {
    scroll-margin-block-start: var(--space-6); /* 24px – plus the header space from scroll-padding in global.css */
  }

  /* Small uppercase title with a line below, across the full width,
     then the tag line under the line (version A of two, decided 31 Oct) */
  .collection-head {
    margin-block-end: var(--space-6); /* 24px to the intro or the cards */
  }

  .collection-title {
    padding-block-end: var(--space-3); /* 12px to the line */
    border-block-end: 1px solid var(--color-line);
  }

  .collection-head .collection-tags {
    margin-block-start: var(--space-3); /* 12px under the line */
  }

  /* The quiet tag line – same look as the product code on the product pages */
  .collection-tags {
    color: var(--color-text-quiet);
    font-size: 0.75rem; /* 12px */
    font-weight: 300;
    line-height: var(--space-4); /* 16px */
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;

    /* A tag never breaks in the middle ("Built for / anywhere") – only between tags */
    & span {
      white-space: nowrap;
    }
  }

  /* Two short lines under the title, never wider than a comfortable read */
  .collection-intro {
    max-inline-size: var(--measure-body);
    margin-block-end: var(--space-6); /* 24px to the cards */
    color: var(--color-text-secondary);
  }

  /* With an intro under it, the head sits 16px above it (24px straight to the cards) */
  .collection-head:has(+ .collection-intro) {
    margin-block-end: var(--space-4);
  }

  /* Base Collection: title on the left, the small button on the right, the line under both */
  .collection-title-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-block-end: var(--space-3);
    border-block-end: 1px solid var(--color-line);

    & .collection-title {
      margin-block-end: 0; /* the button follows, so the heading's own space below would show */
      padding-block-end: 0;
      border: 0;
    }
  }

  /* The small chevron button – the same look as the description button on the
     product page. 40px to tap, but the negative margin keeps the title row 20px high,
     like the Supporter title. */
  .description-toggle {
    display: none; /* without JavaScript: no button, the intro is always there */
    flex-shrink: 0;
    place-items: center end;
    inline-size: var(--control-height);
    block-size: var(--control-height);
    margin-block: calc((var(--leading-small) - var(--control-height)) / 2);
    padding: 0;
    border: 0;
    background: none;
    color: var(--color-text-secondary);
    cursor: pointer;

    &::before {
      content: "";
      inline-size: 0.375rem;
      block-size: 0.375rem;
      border-block-end: 1.5px solid currentColor;
      border-inline-end: 1.5px solid currentColor;
      translate: -2px -2px;
      rotate: 45deg;
    }

    &[aria-expanded="true"]::before {
      translate: -2px 2px;
      rotate: -135deg;
    }

    @media (hover: hover) {
      &:hover {
        color: var(--color-accent);
      }
    }
  }

  /* With JavaScript the button shows, and while it's closed the intro is hidden
     (the head then keeps its normal 24px to the cards) */
  :global(html[data-js]) {
    & .description-toggle {
      display: grid;
    }

    & .collection:has(.description-toggle[aria-expanded="false"]) {
      & .collection-head {
        margin-block-end: var(--space-6);
      }

      & .collection-intro {
        display: none;
      }
    }
  }

  /* 1 column on phones, 2 on tablets, 3 on desktop.
     minmax(0, 1fr), not just 1fr: a plain 1fr column may grow wider than the page
     if its content asks for it – on iPhones the cards ran off the right edge. */
  .product-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-6); /* 24px */
    margin: 0;
    padding: 0;
    list-style: none;

    @media (width >= 40rem) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    @media (width >= 64rem) {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    /* "display: grid" above would beat the hidden attribute – this makes
       hidden win again (used by the empty Favourites list) */
    &[hidden] {
      display: none;
    }
  }

  /* Same surface and line as a product card. From the top down (my layout, 2 Nov):
     title, the print big in the middle, the text at the bottom. */
  .text-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-4); /* 16px */
    padding: var(--space-6); /* 24px */
    border: 1px solid var(--color-line);
    background-color: var(--color-bg);

    & h3 {
      margin: 0;
      font-size: 2rem; /* 32px – one step above the normal H3 */
      line-height: 2.25rem; /* 36px */
    }

    & p {
      margin: 0;
    }

    /* The two texts stay one block: only 8px between them */
    & p + p {
      margin-block-start: calc(var(--space-2) - var(--space-4));
    }
  }

  /* The print, centred. Phone and tablet: 3/4 of the card's width, the card's height follows.
     Desktop: the card stands next to the product cards and has to match their height,
     so the print takes all the height the title and text leave free (object-fit: contain
     = never cut, never stretched). It never gets smaller than 192px high. */
  .text-card-print {
    align-self: center;
    inline-size: 75%;
    block-size: auto;

    @media (width >= 64rem) {
      flex: 1 1 0;
      inline-size: 100%;
      min-block-size: 12rem;
      object-fit: contain;
    }
  }

  .favorites-empty {
    color: var(--color-text-quiet);
  }

  .favorites-coordinates {
    margin-block-start: var(--space-6); /* 24px under the text or the cards */
  }
</style>
