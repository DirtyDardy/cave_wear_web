---
// PRODUCTS (from my products sketch): photo header, Base Collection,
// Supporter Collection, Favorites.
// Every product folder in src/content/products/ becomes a card here by itself.
// Products without a folder yet still show as PLACEHOLDER cards (not clickable).
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import ProductCard from "../components/ProductCard.astro";
import { getProducts, type Product } from "../data/products";
import heroImage from "../assets/products/products-hero.jpg";
import placeholder from "../assets/products/placeholder.jpg";

const products = await getProducts();

// A product folder → what the card needs. Card photo = shot 0,
// hover photo = shot 1 (front) in the first colour and fit.
function toCard(product: Product) {
  return {
    id: product.id,
    name: product.name,
    tagline: product.tagline,
    image: product.shot0.image,
    alt: product.shot0.alt,
    hoverImage: product.shotSets[0].shots[0].image,
    href: `/products/${product.id}`,
    colours: product.colours,
    fits: product.fits,
  };
}

const placeholderAlt = "Placeholder – product photo follows";
const placeholderTagline = "Placeholder – one short line follows.";

// PLACEHOLDER cards for products that have no folder yet. "id" = short name that
// never changes – favorites are saved by it. A placeholder disappears by itself
// as soon as a folder with the same id exists.
const placeholders = {
  "Base Collection": [
    { id: "half-zip", name: "Half-zip", tagline: placeholderTagline, image: placeholder, alt: placeholderAlt },
    { id: "rain-jacket", name: "Rain jacket", tagline: placeholderTagline, image: placeholder, alt: placeholderAlt },
    { id: "beanie", name: "Beanie", tagline: placeholderTagline, image: placeholder, alt: placeholderAlt },
    { id: "buff", name: "Buff", tagline: placeholderTagline, image: placeholder, alt: placeholderAlt },
  ],
  "Supporter Collection": [
    { id: "supporter-tee", name: "Supporter Tee", tagline: placeholderTagline, image: placeholder, alt: placeholderAlt },
    { id: "supporter-hoodie", name: "Supporter Hoodie", tagline: placeholderTagline, image: placeholder, alt: placeholderAlt },
  ],
};

const folderIds = products.map((product) => product.id);

// One collection's cards: first the products from folders, then the placeholders
// that have no folder yet. "..." = put all items of that list in here.
function cardsFor(collection: Product["collection"]) {
  return [
    ...products.filter((product) => product.collection === collection).map(toCard),
    ...placeholders[collection].filter((card) => !folderIds.includes(card.id)),
  ];
}

const baseCollection = cardsFor("Base Collection");
const supporterCollection = cardsFor("Supporter Collection");
---

<BaseLayout title="Products">
  <!-- Photo header: trees in front of a city – the wild and anywhere in one picture.
       top-fade: soft dark fade at the top for the header (global.css) -->
  <section class="products-hero top-fade">
    <Image
      src={heroImage}
      alt=""
      class="products-hero-image"
      widths={[640, 1024, 1600, 2000]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />
    <div class="container products-hero-inner">
      <h1>Products</h1>
    </div>
  </section>

  <div class="container section collections">
    <section class="collection" aria-labelledby="base-title">
      <h2 id="base-title" class="label collection-title">Base Collection</h2>
      <ul class="product-grid" role="list">
        {
          baseCollection.map((product) => (
            <li>
              <ProductCard {...product} />
            </li>
          ))
        }
      </ul>
    </section>

    <section class="collection" aria-labelledby="supporter-title">
      <h2 id="supporter-title" class="label collection-title">Supporter Collection</h2>
      <ul class="product-grid" role="list">
        {
          supporterCollection.map((product) => (
            <li>
              <ProductCard {...product} />
            </li>
          ))
        }
        <!-- Text card in the third column. PLACEHOLDER text. -->
        <li class="text-card">
          <h3>Placeholder headline</h3>
          <p class="small">Placeholder – what the Supporter Collection is and why it exists.</p>
        </li>
      </ul>
    </section>

    <!-- Filled by favorites.js: a copy of every card whose heart is on.
         The list starts hidden; the text shows until there's a favorite. -->
    <section aria-labelledby="favorites-title">
      <h2 id="favorites-title" class="label collection-title">Favorites</h2>
      <ul id="favorites-list" class="product-grid" role="list" hidden></ul>
      <p id="favorites-empty" class="small favorites-empty">No favorites yet. Click the heart on a product to keep it here.</p>
    </section>
  </div>
</BaseLayout>

<script src="../scripts/favorites.js"></script>

<style>
  /* --- Photo header ------------------------------------------------------------
     Same height as the Home hero (--hero-height, global.css), full width,
     under the transparent header – like Home. */
  .products-hero {
    position: relative;
    block-size: var(--hero-height);
    margin-block-start: calc(-1 * var(--header-height) - 1px); /* under the transparent header */
    overflow: hidden;
  }

  /* Vertical position 70% (50% = centre, 100% = bottom edge, decided 24 Oct):
     the forest always stays in view, the skyline is cut away first on short
     or narrow screens. */
  .products-hero-image {
    position: absolute;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    object-position: center 70%;
  }

  /* H1 centred near the bottom, over the trees (dark = readable).
     z-index 2 = above the top fade. */
  .products-hero-inner {
    position: absolute;
    z-index: 2;
    inset: 0;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding-block-end: var(--space-16); /* 64px */
    text-align: center;
  }

  /* --- Collections ------------------------------------------------------------ */

  /* 96px between the three collections (same as the space around a section) */
  .collections {
    display: flex;
    flex-direction: column;
    gap: var(--section-space);
  }

  /* Small uppercase title with a line below, across the full width */
  .collection-title {
    margin-block-end: var(--space-6); /* 24px to the cards */
    padding-block-end: var(--space-3); /* 12px to the line */
    border-block-end: 1px solid var(--color-line);
  }

  /* 1 column on phones, 2 on tablets, 3 on desktop */
  .product-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6); /* 24px */
    margin: 0;
    padding: 0;
    list-style: none;

    @media (width >= 40rem) {
      grid-template-columns: repeat(2, 1fr);
    }

    @media (width >= 64rem) {
      grid-template-columns: repeat(3, 1fr);
    }

    /* "display: grid" above would beat the hidden attribute – this makes
       hidden win again (used by the empty Favorites list) */
    &[hidden] {
      display: none;
    }
  }

  /* Same surface and line as a product card; text centred in the middle */
  .text-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: var(--space-8); /* 32px */
    border: 1px solid var(--color-line);
    background-color: var(--color-bg);
    text-align: center;
  }

  .favorites-empty {
    color: var(--color-text-quiet);
  }
</style>
