---
// PRODUCT PAGE (from my "System Integration" mockup) – one page per product folder
// in src/content/products/. Everything shown comes from that folder: the text file
// and the photos. Nothing here is typed per product.
// Choosing a colour or fit swaps shots 1–5 (src/scripts/product-options.js).
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getProducts, productCode, type Product } from "../../data/products";
import { productFits } from "../../data/product-fits.js";
import { supportChoices } from "../../data/product-support.js";
import HeartIcon from "../../assets/icons/heart.svg";
import CloseIcon from "../../assets/icons/close.svg";

// Astro builds one page for every product folder: /products/core-tee, /products/hoodie …
export async function getStaticPaths() {
  const products = await getProducts();
  return products.map((product) => ({ params: { id: product.id }, props: { product } }));
}

interface Props {
  product: Product;
}

const { product } = Astro.props;

// Where each collection sits on the Products page (breadcrumb link)
const collectionLinks = {
  "Base Collection": "/products#base-title",
  "Supporter Collection": "/products#supporter-title",
};

// The three closed sections at the bottom. A section without text is left out.
const accordions = [
  { title: "Design & Purpose", paragraphs: product.designPurpose },
  { title: "Fit & Silhouette", paragraphs: product.fitSilhouette },
  { title: "Materials", paragraphs: product.materials },
].filter((section) => section.paragraphs.length > 0);

// The Cave Wear code for every colour × fit that exists, e.g. "black|male" → "CW · THZ01 · 1-01".
// The page shows the first one; product-options.js swaps it when a colour or fit is chosen.
const codes = Object.fromEntries(
  product.colours.flatMap((colour) =>
    colour.fits.map((fit) => [`${colour.file}|${fit}`, productCode(product, fit, colour.name)]),
  ),
);
const firstCode = productCode(product, product.colours[0].fits[0], product.colours[0].name);

// Photo sizes: the browser picks the smallest file that is still sharp.
// Big shots are about half the page, the 2×2 shots about a quarter.
// On a phone every photo is one full-width slide of the swipe row.
const bigWidths = [480, 960, 1440];
const bigSizes = "(width >= 64rem) 30rem, 100vw";
const smallWidths = [240, 480, 720, 960];
const smallSizes = "(width >= 64rem) 15rem, (width >= 48rem) 50vw, 100vw";
---

<BaseLayout title={product.name} description={`${product.name} – ${product.tagline}`}>
  <div class="container product-page">
    <nav class="breadcrumb label" aria-label="Breadcrumb">
      <ol role="list">
        <li><a href="/products">Products</a></li>
        <li><a href={collectionLinks[product.collection]}>{product.collection}</a></li>
        <li><span aria-current="page">{product.name}</span></li>
      </ol>
    </nav>

    <div class="product-layout">
      <!-- LEFT: shot 0 big, then shots 1–4 as 2×2, then shot 5 big (if the product has one).
           One set of shots 1–5 per colour × fit – product-options.js shows the chosen one.
           Photos in hidden sets only load when their set is shown. -->
      <!-- Every photo is a button: a click opens it big in the photo viewer
           (photo-viewer.js). data-shot = its number, data-full = the full-size file.
           aria-haspopup="dialog": screen readers say the button opens a window. -->
      <!-- On a phone the same photos become one swipe row with dots under it
           (gallery-dots.js fills in the dots). From 768px: the grid as before. -->
      <div class="gallery-column">
        <div class="gallery">
          <!-- Shot 0: the normal one, plus an own one for a fit if its photo exists
               (e.g. shot_0_traverse-half-zip_female). product-options.js shows the one
               that belongs to the chosen fit – data-fit="" is the normal one. -->
          {
            product.shot0 ? (
              <div class="shot-0" data-product-id={product.id}>
                <button type="button" class="photo-button" data-shot="0" data-fit="" data-full={product.shot0.image.src} aria-haspopup="dialog">
                  <Image
                    src={product.shot0.image}
                    alt={product.shot0.alt}
                    widths={bigWidths}
                    sizes={bigSizes}
                    loading="eager"
                    fetchpriority="high"
                  />
                </button>
                {product.shot0ByFit.map((shot) => (
                  <button
                    type="button"
                    class="photo-button"
                    data-shot="0"
                    data-fit={shot.fit}
                    data-full={shot.image.src}
                    aria-haspopup="dialog"
                    hidden
                  >
                    <Image src={shot.image} alt={shot.alt} widths={bigWidths} sizes={bigSizes} />
                  </button>
                ))}
                <button type="button" class="favorite-button" aria-label={`Favourite ${product.name}`} aria-pressed="false">
                  <HeartIcon class="favorite-icon" />
                </button>
              </div>
            ) : (
              <div class="gallery-favorite" data-product-id={product.id}>
                <button type="button" class="favorite-button" aria-label={`Favourite ${product.name}`} aria-pressed="false">
                  <HeartIcon class="favorite-icon" />
                </button>
              </div>
            )
          }

          {
            product.shotSets.map((set, index) => (
              <div class={`shot-set${product.shot0 ? "" : " no-shot-0"}`} data-colour={set.colour} data-fit={set.fit} hidden={index !== 0}>
                {set.shots.map((shot) => {
                  // Big photos: shot 5, or without a shot 0 the first and the last shot
                  const big = shot.number === 5 || (!product.shot0 && (shot.number === 1 || shot.number === 4));
                  return (
                  <button
                    type="button"
                    class={`photo-button shot-${shot.number}`}
                    data-shot={shot.number}
                    data-full={shot.image.src}
                    aria-haspopup="dialog"
                  >
                    <Image
                      src={shot.image}
                      alt={shot.alt}
                      widths={big ? bigWidths : smallWidths}
                      sizes={big ? bigSizes : smallSizes}
                      loading={!product.shot0 && index === 0 && shot.number === 1 ? "eager" : "lazy"}
                    />
                  </button>
                  );
                })}
              </div>
            ))
          }
        </div>
        <div class="gallery-dots" role="group" aria-label="Choose a photo"></div>
      </div>

      <!-- RIGHT: stays in place while the photos scroll (sticky) -->
      <div class="details">
        <div class="details-block">
          <p class="product-code" data-codes={JSON.stringify(codes)}>{firstCode}</p>
          <h1 class="h2 product-name">{product.name}</h1>
          <!-- Phone: less reading – the longer description is folded away behind the
               small button next to the tagline (description-toggle.js). From 768px,
               or without JavaScript, the description is always there. -->
          <div class="tagline-row">
            <p class="tagline">{product.tagline}</p>
            {product.description.length > 0 && (
              <button
                type="button"
                class="description-toggle"
                aria-expanded="false"
                aria-controls="product-description"
                aria-label="Product description"
              ></button>
            )}
          </div>
          <div id="product-description" class="description-text">
            {product.description.map((paragraph) => <p class="description">{paragraph}</p>)}
          </div>
        </div>

        <div class="details-block">
          <!-- data-price: product-options.js adds the extra of the chosen support to it -->
          <p class="price" data-price={product.price} aria-live="polite">{product.priceText}</p>
          <p class="small price-note">Preliminary Price Estimate.</p>
          <!-- Straight to the pricing question in the FAQ (src/content/faq.yaml, id: pricing) -->
          <a href="/contact#pricing" class="text-link small">Learn more <span aria-hidden="true">›</span></a>
        </div>

        <!-- Size, fit and colour are radio buttons: only one per group can be chosen,
             and they work with the keyboard (arrow keys) without any JavaScript.
             The round dot of the radio button is hidden; the label is what you see. -->
        <div class="details-block options">
          <fieldset>
            <legend class="label">Size:</legend>
            <div class="sizes">
              {
                product.sizes.map((size) => (
                  <label class="size">
                    <!-- Only one size (e.g. "One size")? Then it's already chosen -->
                    <input
                      type="radio"
                      name="size"
                      value={size}
                      checked={product.sizes.length === 1}
                      class="visually-hidden"
                    />
                    {size}
                  </label>
                ))
              }
            </div>
            <!-- Straight to the fit / size chart question in the FAQ (id: size-and-fit) -->
            <a href="/contact#size-and-fit" class="text-link small size-guide">Size chart and fit guide <span aria-hidden="true">›</span></a>
          </fieldset>

          <fieldset>
            <legend class="label">Fit:</legend>
            <div class="circles">
              {
                product.fits.map((fit, index) => {
                  const { icon: FitIcon, label } = productFits[fit];
                  return (
                    <label class="fit">
                      <input type="radio" name="fit" value={fit} checked={index === 0} class="visually-hidden" />
                      <FitIcon class="fit-icon" />
                      <span class="visually-hidden">{label} fit</span>
                    </label>
                  );
                })
              }
            </div>
          </fieldset>

          <fieldset>
            <!-- The chosen colour's name after "Colour:", quiet – so Alpine Oak and Tobacco
                 Brown can't be mixed up. product-options.js changes it with the dot. -->
            <legend class="label">Colour: <span class="chosen-colour">{product.colours[0].name}</span></legend>
            <!-- data-fits: the fits a colour exists in. product-options.js hides the
                 dot for the other fits. -->
            <div class="circles">
              {
                product.colours.map((colour, index) => (
                  <label
                    class="colour"
                    style={`--swatch: ${colour.hex}`}
                    data-very-dark={colour.veryDark ? "" : undefined}
                    data-fits={colour.fits.join(" ")}
                  >
                    <input type="radio" name="colour" value={colour.file} checked={index === 0} class="visually-hidden" />
                    <span class="visually-hidden">{colour.name}</span>
                  </label>
                ))
              }
            </div>
          </fieldset>

          <!-- Supporter Collection: the visitor chooses what the piece supports.
               Same boxes as the sizes; the first choice starts chosen, like fit and colour. -->
          {
            product.collection === "Supporter Collection" && (
              <fieldset class="support">
                <legend class="label">Your support:</legend>
                <div class="sizes">
                  {Object.entries(supportChoices).map(([value, { label }], index) => (
                    <label class="size">
                      <input type="radio" name="support" value={value} checked={index === 0} class="visually-hidden" />
                      {label}
                    </label>
                  ))}
                </div>
                <p class="small note">Planned – nothing is paid now.</p>
              </fieldset>
            )
          }
        </div>

        <div class="details-block">
          <div class="pack-row">
            <!-- Quantity: − and + change the number (quantity.js); typing works too.
                 The "Quantity:" label is only for screen readers – the stepper explains itself. -->
            <div>
              <label for="quantity" class="visually-hidden">Quantity:</label>
              <div class="stepper">
                <button type="button" class="stepper-button" data-step="-1" aria-label="One less">−</button>
                <input id="quantity" name="quantity" type="number" inputmode="numeric" min="1" max="10" value="1" />
                <button type="button" class="stepper-button" data-step="1" aria-label="One more">+</button>
              </div>
            </div>

            <!-- Starts switched off (disabled); product-options.js switches it on once
                 size, fit and colour are chosen. A click puts the choice into the Pack
                 (pack-store.ts) and opens the drawer. data-product = this product's folder. -->
            <button type="button" class="button button-primary add-to-pack" data-product={product.id} disabled>Add to pack</button>
          </div>
          <!-- Says why the button is off. Disappears once a size is chosen and the
               line below moves up (no empty gap) – fit and colour always have one chosen. -->
          <p class="small size-hint">Choose a size</p>
          <p class="small note">No payment – reserve your place for the launch.</p>
        </div>

        <!-- <details> opens and closes without JavaScript. All closed when the page loads. -->
        {
          accordions.map((section) => (
            <details class="accordion">
              <summary>{section.title}</summary>
              <div class="accordion-text">
                {section.paragraphs.map((paragraph) => (
                  <p class="small">{paragraph}</p>
                ))}
              </div>
            </details>
          ))
        }
      </div>
    </div>
  </div>

  <!-- PHOTO VIEWER (from my mockup): a click on a gallery photo opens it big on a
       Dark Obsidian layer, the neighbours left and right. <dialog> is built into the
       browser: Escape closes it, the keyboard stays inside, the page behind is inert.
       photo-viewer.js fills the stage with the photos of the chosen colour and fit. -->
  <dialog class="viewer" aria-label={`${product.name} – photos`}>
    <p class="label viewer-title">{product.name}</p>
    <div class="viewer-stage">
      <button type="button" class="viewer-arrow viewer-prev" aria-label="Previous photo">
        <span aria-hidden="true">‹</span>
      </button>
      <button type="button" class="viewer-arrow viewer-next" aria-label="Next photo">
        <span aria-hidden="true">›</span>
      </button>
      <!-- Phone only: dots inside the photo (photo-viewer.js fills them in) -->
      <div class="viewer-dots" role="group" aria-label="Choose a photo"></div>
    </div>
    <button type="button" class="icon-button viewer-close" aria-label="Close photos">
      <CloseIcon />
    </button>
  </dialog>
</BaseLayout>

<script src="../../scripts/favorites.js"></script>
<script src="../../scripts/product-options.js"></script>
<script src="../../scripts/quantity.js"></script>
<script src="../../scripts/photo-viewer.js"></script>
<script src="../../scripts/gallery-dots.js"></script>
<script src="../../scripts/description-toggle.js"></script>

<style>
  /* Space below the header; the usual section space at the end */
  .product-page {
    padding-block: var(--space-12) var(--section-space); /* 48px · 96px */
  }

  /* --- Breadcrumb: Products > Base Collection > The Core Tee ------------------ */

  .breadcrumb {
    margin-block-end: var(--space-3); /* 12px to the photo */
    color: var(--color-text-quiet);

    & ol {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-2);
      margin: 0;
      padding: 0;
      list-style: none;
    }

    /* ">" between the items. The part after the "/" is what screen readers
       read instead – nothing, the list already tells them it's a path. */
    & li + li::before {
      content: ">" / "";
      margin-inline-end: var(--space-2);
    }

    /* Phone first: the full path, but on one line and smaller (12px) – good to
       have, though hardly anyone uses it, so it shouldn't take much space
       (decided 29 Oct). A product name that doesn't fit is cut with "…".
       From 768px: the normal label size, as before. */
    font-size: 0.75rem;
    line-height: var(--space-4);

    & ol {
      flex-wrap: nowrap;
    }

    & li {
      flex-shrink: 0;
      white-space: nowrap;
    }

    & li:last-child {
      flex-shrink: 1;
      min-inline-size: 0;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    @media (width >= 48rem) {
      font-size: var(--text-small);
      line-height: var(--leading-small);

      & ol {
        flex-wrap: wrap;
      }

      & li {
        white-space: normal;
      }
    }

    & a {
      color: inherit;

      &:hover {
        color: var(--color-accent);
      }
    }

    /* The page you're on: one step lighter (Weathered Bone), so you see where you are */
    & [aria-current="page"] {
      color: var(--color-text-secondary);
    }
  }

  /* --- Two columns ------------------------------------------------------------
     As in my mockup the page content is narrower than the site's full width
     (about 950 of 1500px), so the photos don't fill the whole screen. */
  .breadcrumb,
  .product-layout {
    max-inline-size: 60rem; /* 960px */
    margin-inline: auto;
  }

  .product-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6); /* 24px */

    @media (width >= 64rem) {
      grid-template-columns: 1fr 1fr;
      align-items: start; /* the right column keeps its own height – needed for sticky */
    }
  }

  /* --- Left: photos ------------------------------------------------------------ */

  .gallery :global(img) {
    display: block;
    inline-size: 100%;
    block-size: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  /* Phone (mobile first): one swipe row, one full-width photo at a time. Scroll snap
     makes every swipe stop exactly on a photo. The scrollbar is hidden – the dots
     show that there's more and where you are (a peeking next photo was tried
     29 Oct and dropped: it looked like a mistake). */
  .gallery {
    position: relative; /* the heart of a product without shot 0 sits on it */
    display: flex;
    gap: var(--space-2);
    overflow-x: auto;
    scroll-snap-type: x mandatory; /* sideways only – it can't trap the page scroll */
    overscroll-behavior-x: contain; /* a swipe at the end doesn't go "back" in the browser */
    scrollbar-width: none;

    &::-webkit-scrollbar {
      display: none; /* older Safari */
    }

    @media (prefers-reduced-motion: no-preference) {
      scroll-behavior: smooth; /* a tap on a dot glides to the photo */
    }
  }

  .shot-0,
  .shot-set :global(.photo-button) {
    flex: 0 0 100%;
    scroll-snap-align: start;
  }

  /* On the phone the set is no box of its own – its five photos sit in the row */
  .shot-set {
    display: contents;
  }

  /* Dots under the row: 24px tap area each, the dot itself 6px.
     The photo you see = Egret, the others Flint. */
  .gallery-dots {
    display: flex;
    justify-content: center;
    margin-block-start: var(--space-2);
  }

  /* The same dots inside the photo viewer (phone) */
  .gallery-dots,
  .viewer-dots {
    & :global(.gallery-dot) {
      display: grid;
      place-items: center;
      inline-size: var(--space-6);
      block-size: var(--space-6);
      padding: 0;
      border: 0;
      background: none;
      cursor: pointer;

      &::before {
        content: "";
        inline-size: 6px;
        block-size: 6px;
        border-radius: var(--radius-full);
        background-color: var(--color-input-border);
        transition: background-color 0.2s ease;
      }

      &[aria-current]::before {
        background-color: var(--color-text);
      }
    }
  }

  /* From 768px: no row, no dots – the photo grid from my mockup */
  @media (width >= 48rem) {
    .gallery {
      display: block;
      overflow-x: visible;
    }

    .gallery-dots {
      display: none;
    }
  }

  /* The heart sits on shot 0 (the heart's look is in global.css) */
  .shot-0 {
    position: relative;
  }

  /* No shot 0: the heart keeps its place, top right of the gallery. This wrapper is
     no box of its own, so it adds no extra slide to the phone row. */
  .gallery-favorite {
    display: contents;
  }

  /* Each photo is a button that opens the photo viewer – no button look of its own */
  .photo-button {
    display: block;
    inline-size: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;

    /* "display: block" would beat the hidden attribute (a shot 0 for another fit) */
    &[hidden] {
      display: none;
    }
  }

  /* Front and back on the diagonal – two shots that blend into the dark
     background never share a column:
       1 front     | 3 close-up
       4 close-up  | 2 back
       5 big close-up            */
  .shot-set {
    @media (width >= 48rem) {
      display: grid;
      grid-template-columns: 1fr 1fr;
      grid-template-areas:
        "shot1 shot3"
        "shot4 shot2"
        "shot5 shot5";
    }

    /* A product without shot 0: the front big, back and close-up side by side, the last shot big */
    &.no-shot-0 {
      @media (width >= 48rem) {
        grid-template-areas:
          "shot1 shot1"
          "shot2 shot3"
          "shot4 shot4";
      }
    }

    /* "display: grid" / "contents" would beat the hidden attribute – this makes hidden win again */
    &[hidden] {
      display: none;
    }
  }

  .shot-set :global(.shot-1) { grid-area: shot1; }
  .shot-set :global(.shot-2) { grid-area: shot2; }
  .shot-set :global(.shot-3) { grid-area: shot3; }
  .shot-set :global(.shot-4) { grid-area: shot4; }
  .shot-set :global(.shot-5) { grid-area: shot5; }

  /* --- Right: details ------------------------------------------------------------ */

  /* Sticky – desktop only. The whole column scrolls normally until its top is
     24px below the header, then it stays there while the photos keep scrolling.
     The name at the top is never hidden behind the header (decided 25 Oct). */
  .details {
    @media (width >= 64rem) {
      position: sticky;
      inset-block-start: calc(var(--header-height) + var(--space-6));
    }
  }

  /* Each block ends with a Charcoal line, like in the mockup.
     Compact (version B, decided 25 Oct): 16px instead of 24px, so the whole
     column – with "Add to pack" – fits on a laptop screen. */
  .details-block {
    padding-block: var(--space-4); /* 16px */
    border-block-end: 1px solid var(--color-line);

    &:first-child {
      padding-block-start: 0;
    }
  }

  /* My H1 – Geist in the H2 size and weight (450), normal case like the text file
     (decided 30 Oct: caps shouted next to the uppercase breadcrumb). */
  .product-name {
    max-inline-size: none;
    margin-block-end: var(--space-3);
    font-family: var(--font-body);
    text-transform: none; /* every h1 is uppercase in global.css */
  }

  /* The Cave Wear code above the name, e.g. "CW · THZ01 · 1-01" – a quiet tag, not an
     eye-catcher: the smallest size on the site (12px, like the phone breadcrumb), thin,
     a distant colour. It changes with colour and fit without drawing the eye (no animation).
     Same on every screen size. */
  .product-code {
    margin-block-end: var(--space-2);
    color: var(--color-text-quiet);
    font-size: 0.75rem; /* 12px */
    font-weight: 300;
    line-height: var(--space-4); /* 16px */
    letter-spacing: var(--tracking-wide);
  }

  /* Tagline, and on phones the description button on the right */
  .tagline-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    margin-block-end: var(--space-3);
  }

  .tagline {
    margin: 0;
  }

  /* The button: a 44px tap area (touch size) with the accordions' small chevron
     at its right edge. Negative margins: the big tap area doesn't make the line taller.
     Points down = description folded away, up = shown. */
  .description-toggle {
    display: none; /* without JavaScript: no button, the description is always there */
    flex-shrink: 0;
    place-items: center end;
    inline-size: var(--control-height);
    block-size: var(--control-height);
    margin-block: calc((var(--space-6) - var(--control-height)) / 2);
    padding: 0;
    border: 0;
    background: none;
    color: var(--color-text-secondary);
    cursor: pointer;

    &::before {
      content: "";
      inline-size: 0.375rem;
      block-size: 0.375rem;
      border-block-end: 1.5px solid currentColor;
      border-inline-end: 1.5px solid currentColor;
      translate: -2px -2px;
      rotate: 45deg;
    }

    &[aria-expanded="true"]::before {
      translate: -2px 2px;
      rotate: -135deg;
    }

    @media (hover: hover) {
      &:hover {
        color: var(--color-accent);
      }
    }
  }

  /* Phone first: with JavaScript the button shows, and while it's closed the
     description is hidden (the line under the tagline moves up) */
  :global(html[data-js]) {
    & .description-toggle {
      display: grid;
    }

    & .details-block:has(.description-toggle[aria-expanded="false"]) {
      & .tagline-row {
        margin-block-end: 0;
      }

      & .description-text {
        display: none;
      }
    }
  }

  /* From 768px: no button, the description is always there – more text is fine on a big screen */
  @media (width >= 48rem) {
    :global(html[data-js]) {
      & .description-toggle {
        display: none;
      }

      & .details-block:has(.description-toggle[aria-expanded="false"]) {
        & .tagline-row {
          margin-block-end: var(--space-3);
        }

        & .description-text {
          display: block;
        }
      }
    }
  }

  /* Small size, like the accordion texts – the tagline above is the main line */
  .description {
    color: var(--color-text-quiet);
